// Medic1905 — Prisma Schema for Neon Postgres
// Matches infra/init.sql and adds appointments + doctor_ratings tables

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ── Users ──────────────────────────────────────────────
model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  password      String
  role          Role     @default(PATIENT)
  name          String
  phone         String?
  dateOfBirth   DateTime? @map("date_of_birth") @db.Date
  sex           String?
  language      String   @default("en")
  conditions    Json     @default("[]")
  medications   Json     @default("[]")
  insuranceInfo Json?    @map("insurance_info")
  kycVerified   Boolean  @default(false) @map("kyc_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  labResults        LabResult[]
  labOrdersOrdered  LabOrder[]   @relation("LabOrderOrderedBy")
  labOrdersPatient  LabOrder[]   @relation("LabOrderPatient")
  appointmentsPatient Appointment[] @relation("AppointmentPatient")
  appointmentsDoctor Appointment[] @relation("AppointmentDoctor")
  uploadedResults   LabResult[]  @relation("LabResultUploadedBy")
  verifiedResults   LabResult[]  @relation("LabResultVerifiedBy")
  auditLogs         AuditLog[]
  prescriptionsPatient Prescription[] @relation("PrescriptionPatient")
  prescriptionsDoctor  Prescription[] @relation("PrescriptionDoctor")
  chatMessages       ChatMessage[]
  doctorRatingsGiven DoctorRating[]  @relation("DoctorRatingPatient")
  doctorRatingsReceived DoctorRating[] @relation("DoctorRatingDoctor")

  @@map("users")
}

enum Role {
  PATIENT
  DOCTOR
  LAB_SCIENTIST
  ADMIN
}

// ── Appointments ───────────────────────────────────────
model Appointment {
  id              String   @id @default(uuid()) @db.Uuid
  patientId       String   @map("patient_id") @db.Uuid
  doctorId        String   @map("doctor_id") @db.Uuid
  scheduledAt     DateTime @map("scheduled_at")
  durationMinutes Int      @default(30) @map("duration_minutes")
  status          AppointmentStatus @default(BOOKED)
  reason          String?
  notes           String?
  videoRoomId     String?  @map("video_room_id")
  videoToken      String?  @map("video_token")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  patient        User    @relation("AppointmentPatient", fields: [patientId], references: [id])
  doctor         User    @relation("AppointmentDoctor", fields: [doctorId], references: [id])
  prescriptions  Prescription[]
  chatMessages   ChatMessage[]

  @@map("appointments")
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ── Lab Orders ─────────────────────────────────────────
model LabOrder {
  id        String   @id @default(uuid()) @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  orderedBy String   @map("ordered_by") @db.Uuid
  panelType String   @map("panel_type")
  tests     Json     @default("[]")
  notes     String?
  status    LabOrderStatus @default(ORDERED)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient  User @relation("LabOrderPatient", fields: [patientId], references: [id])
  orderedByUser User @relation("LabOrderOrderedBy", fields: [orderedBy], references: [id])

  @@map("lab_orders")
}

enum LabOrderStatus {
  ORDERED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ── Lab Results ────────────────────────────────────────
model LabResult {
  id            String   @id @default(uuid()) @db.Uuid
  patientId     String   @map("patient_id") @db.Uuid
  panelType     String   @map("panel_type")
  testDate      DateTime @map("test_date") @db.Date
  labName       String?  @map("lab_name")
  values        Json     @default("[]")
  fileUrl       String?  @map("file_url")
  uploadedById  String?  @map("uploaded_by_id") @db.Uuid
  verifiedById  String?  @map("verified_by_id") @db.Uuid
  verifiedAt    DateTime? @map("verified_at")
  status        LabResultStatus @default(PENDING)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  patient     User         @relation(fields: [patientId], references: [id])
  uploadedBy  User?        @relation("LabResultUploadedBy", fields: [uploadedById], references: [id])
  verifiedBy  User?        @relation("LabResultVerifiedBy", fields: [verifiedById], references: [id])
  aiAnalysis  AiAnalysis?

  @@index([patientId])
  @@index([testDate(sort: Desc)])
  @@map("lab_results")
}

enum LabResultStatus {
  PENDING
  PENDING_AI_ANALYSIS
  AI_ANALYSIS_COMPLETE
  VERIFIED
  REJECTED
}

// ── AI Analyses ────────────────────────────────────────
model AiAnalysis {
  id            String   @id @default(uuid()) @db.Uuid
  labResultId   String   @map("lab_result_id") @db.Uuid @unique
  status        AiAnalysisStatus @default(PENDING)
  doctorView    Json?    @map("doctor_view")
  patientView   Json?    @map("patient_view")
  flags         Json     @default("{}")
  urgencyLevel  String   @default("routine") @map("urgency_level")
  confidence    Json     @default("{}")
  safetyReport  Json     @default("{}") @map("safety_report")
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  labResult LabResult @relation(fields: [labResultId], references: [id])

  @@map("ai_analyses")
}

enum AiAnalysisStatus {
  PENDING
  COMPLETED
  COMPLETED_WITH_OVERRIDE
  FAILED
  BLOCKED
}

// ── Doctor Ratings ─────────────────────────────────────
model DoctorRating {
  id        String   @id @default(uuid()) @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  doctorId  String   @map("doctor_id") @db.Uuid
  rating    Int      // 1-5 stars
  review    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient User @relation("DoctorRatingPatient", fields: [patientId], references: [id])
  doctor  User @relation("DoctorRatingDoctor", fields: [doctorId], references: [id])

  @@unique([patientId, doctorId])
  @@map("doctor_ratings")
}

// ── Audit Logs ─────────────────────────────────────────
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id") @db.Uuid
  details      Json     @default("{}")
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

// ── Prescriptions ──────────────────────────────────────
model Prescription {
  id            String   @id @default(uuid()) @db.Uuid
  patientId     String   @map("patient_id") @db.Uuid
  doctorId      String   @map("doctor_id") @db.Uuid
  appointmentId String?  @map("appointment_id") @db.Uuid
  medications   Json     @default("[]")
  status        PrescriptionStatus @default(ACTIVE)
  createdAt     DateTime @default(now()) @map("created_at")

  patient     User        @relation("PrescriptionPatient", fields: [patientId], references: [id])
  doctor      User        @relation("PrescriptionDoctor", fields: [doctorId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@map("prescriptions")
}

enum PrescriptionStatus {
  ACTIVE
  DISCONTINUED
  EXPIRED
}

// ── Chat Messages ──────────────────────────────────────
model ChatMessage {
  id            String   @id @default(uuid()) @db.Uuid
  appointmentId String?  @map("appointment_id") @db.Uuid
  senderId      String   @map("sender_id") @db.Uuid
  message       String
  messageType   String   @default("TEXT") @map("message_type")
  createdAt     DateTime @default(now()) @map("created_at")

  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  sender      User         @relation(fields: [senderId], references: [id])

  @@index([appointmentId])
  @@map("chat_messages")
}

// ── Medical Knowledge (for RAG) ────────────────────────
model MedicalKnowledge {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  content   String
  source    String?
  category  String?
  embedding Unsupported("vector(384)")?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([category])
  @@map("medical_knowledge")
}
