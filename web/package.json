{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../.env -- next dev",
    "build": "dotenv -e ../.env -- prisma generate --schema ../prisma/schema.prisma && dotenv -e ../.env -- next build",
    "postinstall": "dotenv -e ../.env -- prisma generate --schema ../prisma/schema.prisma",
    "start": "dotenv -e ../.env -- next start",
    "lint": "eslint",
    "prisma:generate": "dotenv -e ../.env -- prisma generate --schema ../prisma/schema.prisma",
    "prisma:validate": "dotenv -e ../.env -- prisma validate --schema ../prisma/schema.prisma",
    "prisma:push": "dotenv -e ../.env -- prisma db push --schema ../prisma/schema.prisma"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@clerk/nextjs": "^7.9.7",
    "@clerk/themes": "^2.4.57",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^7.10.0",
    "axios": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
