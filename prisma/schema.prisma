  verifiedBy         FacilityStaff?               @relation("CredentialVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@unique([staffId, type, number])
  @@index([staffId])
  @@index([expiryDate])
  @@map("staff_credentials")
}

model ClinicalPrivilege {
  id           String   @id @default(uuid()) @db.Uuid
  staffId      String   @map("staff_id") @db.Uuid
  staff        FacilityStaff @relation(fields: [staffId], references: [id], onDelete: Restrict)
  credentialId String   @map("credential_id") @db.Uuid
