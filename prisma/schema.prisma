  email                String               @db.VarChar(120)
  fullName             String               @map("full_name") @db.VarChar(120)
  facilityRole         FacilityStaffRole
  departmentId         String?              @map("department_id") @db.Uuid
  branchId             String?              @map("branch_id") @db.Uuid
  employmentType       EmploymentType?
  status               FacilityStaffStatus  @default(INVITED)
  /// Single-use invite token; cleared once redeemed.
  inviteToken          String?              @unique @map("invite_token") @db.VarChar(64)
  inviteExpiresAt      DateTime?            @map("invite_expires_at")
  invitedById          String?              @map("invited_by_id") @db.Uuid
  acceptedAt           DateTime?            @map("accepted_at")
  /// Facility-controlled directory visibility. Publication also requires staff consent.
  publicProfileVisible Boolean              @default(false) @map("public_profile_visible")
  /// The staff member's own affirmative, revocable consent to appear on the public portfolio.
  profileConsent       Boolean              @default(false) @map("profile_consent")
  profileConsentAt     DateTime?            @map("profile_consent_at")
  bookingEligible      Boolean              @default(false) @map("booking_eligible")
  professionalTitle    String?              @map("professional_title") @db.VarChar(120)
  photoUrl             String?              @map("photo_url") @db.VarChar(500)
  qualifications       String?
  specialty            String?
  yearsExperience      Int?                 @map("years_experience")
  bio                  String?
  linkedinUrl          String?              @map("linkedin_url") @db.VarChar(300)
  /// LinkedIn is only shown publicly when both this and profileConsent are true.
  linkedinPublic       Boolean              @default(false) @map("linkedin_public")
  languages            String[]             @default([])
  lastLoginAt          DateTime?            @map("last_login_at")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  facility             LabStaffProfile      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  user                 User?                @relation("FacilityStaffUser", fields: [userId], references: [id], onDelete: SetNull)
  department           FacilityDepartment?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  departmentLeadOf     FacilityDepartment[] @relation("DepartmentLead")
  branch               FacilityBranch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  credentials          StaffCredential[]
  verifiedCredentials  StaffCredential[]    @relation("CredentialVerifiedBy")
  assignedBookings     FacilityBooking[]    @relation("BookingAssignedStaff")

  @@unique([facilityId, email])
  @@index([facilityId, status])
  @@index([userId])
  @@map("facility_staff")
}

