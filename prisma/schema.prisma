  /// Facility-controlled directory visibility. Publication also requires staff consent.
  /// Facility-defined custom staff category label (e.g. "Sonographer", "Ward Manager").
  customCategory       String?              @map("custom_category") @db.VarChar(120)
  /// Patient-record reach inside this facility. See StaffAccessLevel docs.
  accessLevel          StaffAccessLevel     @default(STANDARD) @map("access_level")
  /// Extra department ids for EXTENDED access (facility's own departments only).
  departmentIds        String[]             @default([]) @map("department_ids")
  /// Per-staff permission overrides applied to the role defaults:
  /// { "add": ["ENTER_RESULTS"], "remove": ["RELEASE_RESULTS"] } (CUSTOM access level).
  permissionOverrides  Json                 @default("{}") @map("permission_overrides")
  publicProfileVisible Boolean              @default(false) @map("public_profile_visible")
  /// The staff member's own affirmative, revocable consent to appear on the public portfolio.
  profileConsent       Boolean              @default(false) @map("profile_consent")
  profileConsentAt     DateTime?            @map("profile_consent_at")
  bookingEligible      Boolean              @default(false) @map("booking_eligible")
  professionalTitle    String?              @map("professional_title") @db.VarChar(120)
  photoUrl             String?              @map("photo_url") @db.VarChar(500)
  qualifications       String?
  specialty            String?
  yearsExperience      Int?                 @map("years_experience")
  bio                  String?
  linkedinUrl          String?              @map("linkedin_url") @db.VarChar(300)
  /// LinkedIn is only shown publicly when both this and profileConsent are true.
  linkedinPublic       Boolean              @default(false) @map("linkedin_public")
  languages            String[]             @default([])
  lastLoginAt          DateTime?            @map("last_login_at")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  facility             LabStaffProfile      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  user                 User?                @relation("FacilityStaffUser", fields: [userId], references: [id], onDelete: SetNull)
  department           FacilityDepartment?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  departmentLeadOf     FacilityDepartment[] @relation("DepartmentLead")
  branch               FacilityBranch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  credentials          StaffCredential[]
  verifiedCredentials  StaffCredential[]    @relation("CredentialVerifiedBy")
  assignedBookings     FacilityBooking[]    @relation("BookingAssignedStaff")
  patientAccessGrants  StaffPatientAccess[]
  breakGlassAccesses   BreakGlassAccess[]

  @@unique([facilityId, email])
  @@unique([facilityId, userId])
  @@index([facilityId, status])
  @@index([userId])
  @@map("facility_staff")
}

/// An explicit grant that lets a specific staff member reach a specific
/// patient's records at this facility. Grants are facility-scoped, audited,
/// optionally temporary, and can be revoked at any time. A staff account
/// alone never implies access to every patient.
model StaffPatientAccess {
  id            String                  @id @default(uuid()) @db.Uuid
  facilityId    String                  @map("facility_id") @db.Uuid
  staffId       String                  @map("staff_id") @db.Uuid
  patientId     String                  @map("patient_id") @db.Uuid
  scope         StaffPatientAccessScope @default(CARE_TEAM)
  justification String?                 @db.VarChar(500)
  /// TEMPORARY grants expire; null means no expiry.
  expiresAt     DateTime?
  grantedById   String                  @map("granted_by_id") @db.Uuid
  grantedAt     DateTime                @default(now()) @map("granted_at")
  revokedAt     DateTime?
  revokedById   String?                 @map("revoked_by_id") @db.Uuid

  staff         FacilityStaff           @relation(fields: [staffId], references: [id], onDelete: Cascade)
  patient       Patient                 @relation("StaffPatientAccessPatient", fields: [patientId], references: [id], onDelete: Cascade)
  grantedBy     User                    @relation("StaffPatientAccessGrantedBy", fields: [grantedById], references: [id])
  revokedBy     User?                   @relation("StaffPatientAccessRevokedBy", fields: [revokedById], references: [id])

  @@unique([staffId, patientId])
  @@index([facilityId, staffId])
  @@index([patientId])
  @@map("staff_patient_access")
}

/// Emergency ("break-glass") access to a patient's records. Requires a
/// mandatory justification, is time-limited, and every grant is audited and
/// shown to compliance officers. Access ends at expiry or when closed.
model BreakGlassAccess {
  id             String    @id @default(uuid()) @db.Uuid
  facilityId     String    @map("facility_id") @db.Uuid
  staffId        String    @map("staff_id") @db.Uuid
  patientId      String    @map("patient_id") @db.Uuid
  /// Mandatory clinical or safety justification (minimum 20 characters).
  justification   String    @db.VarChar(2000)
  grantedAt      DateTime  @default(now()) @map("granted_at")
  /// Hard expiry (default 4 hours from grant).
  expiresAt      DateTime
  closedAt       DateTime?
  closedReason   String?   @db.VarChar(500)

  staff          FacilityStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  patient        Patient       @relation("BreakGlassPatient", fields: [patientId], references: [id], onDelete: Cascade)

  @@index([facilityId, staffId])
  @@index([patientId])
  @@index([expiresAt])
  @@map("break_glass_access")
}

model StaffCredential {
  clinicalPrivileges ClinicalPrivilege[]
  id                 String                       @id @default(uuid()) @db.Uuid
  staffId            String                       @map("staff_id") @db.Uuid
  type               StaffCredentialType
  number             String                       @db.VarChar(80)
  authority          String                       @db.VarChar(160)
  issueDate          DateTime?                    @map("issue_date") @db.Date
  expiryDate         DateTime?                    @map("expiry_date") @db.Date
  verificationStatus CredentialVerificationStatus @default(UNVERIFIED) @map("verification_status")
  verifiedById       String?                      @map("verified_by_id") @db.Uuid
  verifiedAt         DateTime?                    @map("verified_at")
  documentKey        String?                      @map("document_key")
  restrictions       String?
  renewalStatus      CredentialRenewalStatus      @default(CURRENT) @map("renewal_status")
  /// Last reminder threshold (90/60/30/7 days) already sent — avoids duplicate reminders.
  lastReminderStage  Int?                         @map("last_reminder_stage")
  createdAt          DateTime                     @default(now()) @map("created_at")
