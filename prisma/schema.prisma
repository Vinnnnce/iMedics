generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  clinicalDocumentsAuthored ClinicalDocument[] @relation("ClinicalDocumentAuthor")
  id                     String                   @id @default(uuid()) @db.Uuid
  clerkId                String                   @unique @map("clerk_id")
  email                  String                   @unique
  name                   String
  phone                  String?
  avatarUrl              String?                  @map("avatar_url")
  language               String                   @default("en")
  role                   Role                     @default(PATIENT)
  accountType            AccountType?             @map("account_type")
  status                 UserStatus               @default(ACTIVE)
  onboardingComplete     Boolean                  @default(false) @map("onboarding_complete")
  termsAcceptedAt        DateTime?                @map("terms_accepted_at")
  termsVersion           String?                  @map("terms_version")
  lastLoginAt            DateTime?                @map("last_login_at")
  /// Why an admin suspended or banned the account; shown to the user and kept for the record.
  statusReason           String?                  @map("status_reason")
  statusChangedAt        DateTime?                @map("status_changed_at")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  deletedAt              DateTime?                @map("deleted_at")
  aiReviews              AiAnalysis[]             @relation("AiAnalysisReviewedBy")
  noteTemplates          NoteTemplate[]
  auditLogs              AuditLog[]
  messagesSent           ChatMessage[]
  doctorProfile          DoctorProfile?           @relation("DoctorProfileUser")
  doctorsVerified        DoctorProfile[]          @relation("DoctorVerifiedBy")
  labOrdersOrdered       LabOrder[]               @relation("LabOrderOrderedBy")
  labResultsUploaded     LabResult[]              @relation("LabResultUploadedBy")
  labResultsVerified     LabResult[]              @relation("LabResultVerifiedBy")
  labStaffProfile        LabStaffProfile?         @relation("LabStaffProfileUser")
  labStaffVerified       LabStaffProfile[]        @relation("LabStaffVerifiedBy")
  notifications          Notification[]
  notificationPrefs      NotificationPreference[]
  pushSubscriptions      PushSubscription[]
  documentsUploaded      PatientDocument[]        @relation("PatientDocumentUploaded")
  facilityDocTemplates    FacilityDocumentTemplate[] @relation("FacilityDocumentTemplateAuthor")
  documentSharesReceived DocumentShare[]          @relation("DocumentShareRecipient")
  trustedContactAccount  TrustedContact[]         @relation("TrustedContactUser")
  lastActiveAt           DateTime?                @map("last_active_at")
  paymentsMade           Payment[]                @relation("PaymentPayer")
  paymentsReceived       Payment[]                @relation("PaymentPayee")
  patient                Patient?
  verificationDocuments  VerificationDocument[]
  verificationReviews    VerificationReview[]     @relation("VerificationSubject")
  verificationsDecided   VerificationReview[]     @relation("VerificationReviewer")
  facilityStaffMembers   FacilityStaff[]          @relation("FacilityStaffUser")
  providerSubaccount     ProviderSubaccount?
  refundsDecided         Refund[]                 @relation("RefundDecidedBy")
  refundsRequested       Refund[]                 @relation("RefundRequestedBy")
  admissionNotesAuthored  AdmissionNote[]
  wardTransfersRecorded   WardTransfer[]
  labResultAmendments     LabResultAmendment[]    @relation("LabResultAmendedBy")
  specimensCollected     Specimen[]               @relation("SpecimenCollectedBy")
  specimensReceived      Specimen[]               @relation("SpecimenReceivedBy")
  diagnosticReportsDrafted DiagnosticReport[]       @relation("DiagnosticReportDraftedBy")
  diagnosticReportsVerified DiagnosticReport[]     @relation("DiagnosticReportVerifiedBy")
  diagnosticReportsSigned DiagnosticReport[]       @relation("DiagnosticReportSignedBy")
  diagnosticReportVersions DiagnosticReportVersion[] @relation("DiagnosticReportVersionBy")
  diagnosticImagesUploaded DiagnosticImage[]       @relation("DiagnosticImageUploadedBy")
  criticalAlertsAcked     CriticalResultAlert[]    @relation("CriticalAlertAcknowledgedBy")

  @@index([role])
  @@index([status])
  @@map("users")
}

model DoctorProfile {
  id                        String                @id @default(uuid()) @db.Uuid
  userId                    String                @unique @map("user_id") @db.Uuid
  middleName                String?               @map("middle_name")
  dateOfBirth               DateTime?             @map("date_of_birth") @db.Date
  gender                    Gender?
  licenseNumber             String?               @map("license_number")
  mdcnRegistrationNumber    String?               @unique @map("mdcn_registration_number")
  yearOfRegistration        Int?                  @map("year_of_registration")
  yearsOfExperience         Int?                  @map("years_of_experience")
  specialty                 String?
  subSpecialty              String?               @map("sub_specialty")
  affiliation               String?
  biography                 String?
  education                 String?
  languages                 String[]
  areasOfExpertise          String[]              @map("areas_of_expertise")
  location                  String?
  consultationFee           Decimal?              @map("consultation_fee") @db.Decimal(12, 2)
  followUpFee               Decimal?              @map("follow_up_fee") @db.Decimal(12, 2)
  followUpWindowDays        Int                   @default(14) @map("follow_up_window_days")
  currency                  String                @default("NGN")
  acceptingPatients         Boolean               @default(true) @map("accepting_patients")
  aiToolsEnabled            Boolean               @default(false) @map("ai_tools_enabled")
  verificationStatus        VerificationStatus    @default(PENDING) @map("verification_status")
  verifiedAt                DateTime?             @map("verified_at")
  verifiedById              String?               @map("verified_by_id") @db.Uuid
  ratingAvg                 Float                 @default(0) @map("rating_avg")
  ratingCount               Int                   @default(0) @map("rating_count")
  likeCount                 Int                   @default(0) @map("like_count")
  createdAt                 DateTime              @default(now()) @map("created_at")
  updatedAt                 DateTime              @updatedAt @map("updated_at")
  appointments              Appointment[]
  clinicalNotes             ClinicalNote[]
  consultations             Consultation[]
  conversations             Conversation[]
  likes                     DoctorLike[]
  user                      User                  @relation("DoctorProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy                User?                 @relation("DoctorVerifiedBy", fields: [verifiedById], references: [id])
  reviews                   DoctorReview[]
  schedule                  DoctorSchedule[]
  assignments               PatientAssignment[]
  prescriptions             Prescription[]
  careCases                 CareCase[]            @relation("CareCasePrimaryDoctor")
  admissionsAdmitted        Admission[]            @relation("AdmissionAdmittingDoctor")
  sentFacilityReferrals     FacilityReferral[]    @relation("ReferralFromDoctor")
  professionalTitle         String?               @map("professional_title")
  qualifications            String?
  clinicalInterests         String[]              @default([]) @map("clinical_interests")
  conditionsTreated         String[]              @default([]) @map("conditions_treated")
  proceduresPerformed       String[]              @default([]) @map("procedures_performed")
  patientCarePhilosophy     String?               @map("patient_care_philosophy")
  consultationApproach      String?               @map("consultation_approach")
  whenToBookGuidance        String?               @map("when_to_book_guidance")
  consultationModes         AppointmentMode[]     @default([]) @map("consultation_modes")
  linkedinUrl               String?               @map("linkedin_url")
  linkedinPublic            Boolean               @default(false) @map("linkedin_public")
  linkedinConsentAt         DateTime?             @map("linkedin_consent_at")
  cvFileId                  String?               @unique @map("cv_file_id") @db.Uuid
  cvFile                    DoctorFile?           @relation("DoctorCvFile", fields: [cvFileId], references: [id])
  licensingAuthority        String?               @map("licensing_authority")
  licenseExpiry             DateTime?             @map("license_expiry")
  licensePublic             Boolean               @default(false) @map("license_public")
  professionalMemberships   String[]              @default([]) @map("professional_memberships")
  awards                    String[]              @default([])
  hospitalAffiliations      String[]              @default([]) @map("hospital_affiliations")
  identityVerification      VerificationStatus?   @map("identity_verification")
  identityVerifiedAt        DateTime?             @map("identity_verified_at")
  licenseVerification       VerificationStatus?   @map("license_verification")
  licenseVerifiedAt         DateTime?             @map("license_verified_at")
  qualificationVerification VerificationStatus?   @map("qualification_verification")
  qualificationVerifiedAt   DateTime?             @map("qualification_verified_at")
  services                  DoctorService[]
  portfolioItems            DoctorPortfolioItem[]
  files                     DoctorFile[]          @relation("DoctorOwnedFiles")
  subscription              DoctorSubscription?
  subaccount                ProviderSubaccount?

  @@index([specialty])
  @@index([verificationStatus])
  @@index([verificationStatus, ratingAvg(sort: Desc), ratingCount(sort: Desc)], map: "doctor_profiles_top_rated_idx")
  @@map("doctor_profiles")
}

model LabStaffProfile {
  hospitalSettings        HospitalSettings?          @relation("HospitalSettingsFacility")
  clinicalTemplates       ClinicalDocumentTemplate[] @relation("ClinicalTemplateFacility")
  clinicalDocuments       ClinicalDocument[]         @relation("ClinicalDocumentFacility")
  encounters              Encounter[]                @relation("EncounterFacility")
  payerCoverages          PayerCoverage[]            @relation("PayerCoverageFacility")
  medicalMedia            MedicalMedia[]             @relation("MedicalMediaFacility")
  id                      String                  @id @default(uuid()) @db.Uuid
  userId                  String                  @unique @map("user_id") @db.Uuid
  laboratoryName          String?                 @map("laboratory_name")
  position                String?
  licenseIdNumber         String?                 @map("license_id_number")
  cacRegistrationNumber   String?                 @map("cac_registration_number")
  facilityLicenseNumber   String?                 @map("facility_license_number")
  departments             String[]
  addressLine             String?                 @map("address_line")
  city                    String?
  state                   String?
  operatingHours          String?                 @map("operating_hours")
  about                   String?
  verificationStatus      VerificationStatus      @default(PENDING) @map("verification_status")
  verifiedAt              DateTime?               @map("verified_at")
  verifiedById            String?                 @map("verified_by_id") @db.Uuid
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")
  services                FacilityService[]
  user                    User                    @relation("LabStaffProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy              User?                   @relation("LabStaffVerifiedBy", fields: [verifiedById], references: [id])
  slug                    String?                 @unique @db.VarChar(80)
  isPublished             Boolean                 @default(false) @map("is_published")
  tagline                 String?                 @db.VarChar(200)
  mission                 String?                 @db.VarChar(500)
  vision                  String?                 @db.VarChar(500)
  ownershipType           OwnershipType?
  establishedYear         Int?                    @map("established_year")
  bedCount                Int?                    @map("bed_count")
  theatreCount            Int?                    @map("theatre_count")
  laboratoryCount         Int?                    @map("laboratory_count")
  imagingRoomCount        Int?                    @map("imaging_room_count")
  languagesSpoken         String[]                @default([]) @map("languages_spoken")
  paymentMethods          String[]                @default([]) @map("payment_methods")
  emergencyContact        String?                 @map("emergency_contact") @db.VarChar(200)
  phone                   String?                 @db.VarChar(40)
  email                   String?                 @db.VarChar(120)
  logoUrl                 String?                 @map("logo_url") @db.VarChar(500)
  galleryImageKeys        String[]                @default([]) @map("gallery_image_keys")
  ratingAvg               Float                   @default(0) @map("rating_avg")
  ratingCount             Int                     @default(0) @map("rating_count")
  commissionBps           Int?                    @map("commission_bps")
  subaccountCode          String?                 @map("subaccount_code") @db.VarChar(60)
  settlementBank          String?                 @map("settlement_bank") @db.VarChar(100)
  settlementAccountNumber String?                 @map("settlement_account_number") @db.VarChar(40)
  subaccount              ProviderSubaccount?
  commissionRules         CommissionRule[]
  website                 FacilityWebsite?
  branches                FacilityBranch[]
  facilityDepartments     FacilityDepartment[]
  staffMembers            FacilityStaff[]
  referrals               FacilityReferral[]
  accreditations          FacilityAccreditation[]
  documentTemplates       FacilityDocumentTemplate[]
  issuedDocuments         PatientDocument[]         @relation("IssuingFacility")
  documentShares          DocumentFacilityShare[]   @relation("FacilityDocumentShares")
  reviews                 FacilityReview[]
  /// Organization type of this facility, denormalized from the owner's account type at creation.
  kind                    FacilityKind?
  specimens              Specimen[]
  admissions             Admission[]
  transferredAdmissions   Admission[]            @relation("AdmissionTransferredToFacility")
  referredBookings       FacilityBooking[]        @relation("BookingRequestingFacility")
  requestingLabOrders     LabOrder[]               @relation("LabOrderRequestingFacility")
  performingLabOrders     LabOrder[]               @relation("LabOrderPerformingFacility")
  diagnosticReportsIssued DiagnosticReport[]
  diagnosticReportsSentTo DiagnosticReport[]       @relation("DiagnosticReportSentToFacility")
  criticalAlertsOrdered   CriticalResultAlert[]    @relation("CriticalAlertOrderingFacility")

  @@index([verificationStatus])
  @@index([isPublished, verificationStatus, kind, ratingAvg(sort: Desc)], map: "lab_staff_profiles_top_rated_idx")
  @@map("lab_staff_profiles")
}

enum FacilityKind {
  LABORATORY
  DIAGNOSTIC_CENTRE
  HOSPITAL
}

model DoctorSchedule {
  id          String        @id @default(uuid()) @db.Uuid
  doctorId    String        @map("doctor_id") @db.Uuid
  dayOfWeek   Int           @map("day_of_week")
  startTime   String        @map("start_time")
  endTime     String        @map("end_time")
  slotMinutes Int           @default(30) @map("slot_minutes")
  isActive    Boolean       @default(true) @map("is_active")
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek, startTime])
  @@map("doctor_schedules")
}

model DoctorReview {
  id                    String           @id @default(uuid()) @db.Uuid
  doctorId              String           @map("doctor_id") @db.Uuid
  patientId             String           @map("patient_id") @db.Uuid
  rating                Int
  comment               String?
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  doctor                DoctorProfile    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient               Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  communicationRating   Int?             @map("communication_rating")
  professionalismRating Int?             @map("professionalism_rating")
  punctualityRating     Int?             @map("punctuality_rating")
  explanationRating     Int?             @map("explanation_rating")
  moderationStatus      ReviewModeration @default(APPROVED) @map("moderation_status")
  moderatedAt           DateTime?        @map("moderated_at")
  doctorResponse        String?          @map("doctor_response")
  doctorRespondedAt     DateTime?        @map("doctor_responded_at")

  @@unique([patientId, doctorId])
  @@index([doctorId])
  @@map("doctor_reviews")
}

model DoctorLike {
  id        String        @id @default(uuid()) @db.Uuid
  doctorId  String        @map("doctor_id") @db.Uuid
  patientId String        @map("patient_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at")
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient   Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, doctorId])
  @@map("doctor_likes")
}

model Patient {
  clinicalDocuments ClinicalDocument[]   @relation("ClinicalDocumentPatient")
  encounters        Encounter[]          @relation("EncounterPatient")
  payerCoverages    PayerCoverage[]      @relation("PayerCoveragePatient")
  medicalMedia      MedicalMedia[]       @relation("MedicalMediaPatient")
  id                String               @id @default(uuid()) @db.Uuid
  caseNumber        String               @unique @map("case_number")
  userId            String?              @unique @map("user_id") @db.Uuid
  firstName         String               @map("first_name")
  lastName          String               @map("last_name")
  middleName        String?              @map("middle_name")
  gender            Gender
  dateOfBirth       DateTime             @map("date_of_birth") @db.Date
  height            Float?
  weight            Float?
  bloodGroup        String?              @map("blood_group")
  genotype          String?
  occupation        String?
  addressLine1      String?              @map("address_line1")
  addressLine2      String?              @map("address_line2")
  city              String?
  state             String?
  postalCode        String?              @map("postal_code")
  country           String?              @default("NG")
  ecName            String?              @map("ec_name")
  ecRelationship    String?              @map("ec_relationship")
  ecPhone           String?              @map("ec_phone")
  ecAddress         String?              @map("ec_address")
  insurance         Json?
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  deletedAt         DateTime?            @map("deleted_at")
  appointments      Appointment[]
  clinicalNotes     ClinicalNote[]
  consultations     Consultation[]
  conversations     Conversation[]
  likes             DoctorLike[]
  reviews           DoctorReview[]
  labOrders         LabOrder[]
  labResults        LabResult[]
  medicalHistories  MedicalHistory[]
  assignments       PatientAssignment[]
  facilityBookings  FacilityBooking[]
  user              User?                @relation(fields: [userId], references: [id])
  prescriptions     Prescription[]
  preferredName     String?              @map("preferred_name")
  organDonorStatus  Boolean?             @map("organ_donor_status")
  careCases         CareCase[]
  documents         PatientDocument[]
  facilityReviews   FacilityReview[]
  reminders         MedicationReminder[]
  doseEvents        DoseEvent[]
  trustedContacts   TrustedContact[]
  inactivityRule    InactivityRule?
  facilityReferrals FacilityReferral[]   @relation("ReferralPatient")
  /// Hospital admissions (Module 01).
  admissions        Admission[]
  criticalAlerts    CriticalResultAlert[]

  @@index([lastName, firstName])
  @@index([deletedAt])
  @@map("patients")
}

model PatientAssignment {
  id           String           @id @default(uuid()) @db.Uuid
  patientId    String           @map("patient_id") @db.Uuid
  doctorId     String           @map("doctor_id") @db.Uuid
  status       AssignmentStatus @default(ACTIVE)
  admittedAt   DateTime         @default(now()) @map("admitted_at")
  dischargedAt DateTime?        @map("discharged_at")
  notes        String?
  doctor       DoctorProfile    @relation(fields: [doctorId], references: [id])
  patient      Patient          @relation(fields: [patientId], references: [id])

  @@unique([patientId, doctorId])
  @@index([doctorId, status])
  @@map("patient_assignments")
}

model MedicalHistory {
  id                        String       @id @default(uuid()) @db.Uuid
  patientId                 String       @map("patient_id") @db.Uuid
  status                    RecordStatus @default(DRAFT)
  chiefComplaint            String?      @map("chief_complaint")
  symptoms                  Json         @default("[]")
  medications               Json         @default("[]")
  hasWound                  Boolean      @default(false) @map("has_wound")
  woundLocation             String?      @map("wound_location")
  woundType                 String?      @map("wound_type")
  woundTimeSinceInjury      String?      @map("wound_time_since_injury")
  woundCause                String?      @map("wound_cause")
  hasDiabetes               Boolean      @default(false) @map("has_diabetes")
  diabetesDuration          String?      @map("diabetes_duration")
  diabetesType              String?      @map("diabetes_type")
  diabetesControl           String?      @map("diabetes_control")
  hasStroke                 Boolean      @default(false) @map("has_stroke")
  strokeDate                String?      @map("stroke_date")
  strokeResidual            String?      @map("stroke_residual")
  hasHeartAttack            Boolean      @default(false) @map("has_heart_attack")
  heartAttackDate           String?      @map("heart_attack_date")
  heartAttackInterventions  String?      @map("heart_attack_interventions")
  familyHistory             Json         @default("[]") @map("family_history")
  pastHistory               Json         @default("[]") @map("past_history")
  allergies                 Json         @default("[]")
  smokingStatus             String?      @map("smoking_status")
  smokingQuantity           String?      @map("smoking_quantity")
  alcoholUse                String?      @map("alcohol_use")
  physicalActivity          String?      @map("physical_activity")
  sleepPattern              String?      @map("sleep_pattern")
  pregnancies               Int?
  deliveries                Int?
  reproductiveComplications String?      @map("reproductive_complications")
  mentalHealth              Json         @default("[]") @map("mental_health")
  immunizations             Json         @default("[]")
  completedAt               DateTime?    @map("completed_at")
  createdAt                 DateTime     @default(now()) @map("created_at")
  updatedAt                 DateTime     @updatedAt @map("updated_at")
  aiAnalysis                AiAnalysis?
  patient                   Patient      @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@map("medical_histories")
}

model Appointment {
  id                String              @id @default(uuid()) @db.Uuid
  patientId         String              @map("patient_id") @db.Uuid
  doctorId          String              @map("doctor_id") @db.Uuid
  scheduledAt       DateTime            @map("scheduled_at")
  durationMinutes   Int                 @default(30) @map("duration_minutes")
  mode              AppointmentMode     @default(VIDEO)
  status            AppointmentStatus   @default(BOOKED)
  reason            String?
  notes             String?
  videoRoomId       String?             @map("video_room_id")
  followUpOfId      String?             @map("follow_up_of_id") @db.Uuid
  feeKind           ConsultationFeeKind @default(STANDARD) @map("fee_kind")
  feeAmount         Decimal             @default(0) @map("fee_amount") @db.Decimal(12, 2)
  feeCurrency       String              @default("NGN") @map("fee_currency")
  reminder24hSentAt DateTime?           @map("reminder_24h_sent_at")
  reminder1hSentAt  DateTime?           @map("reminder_1h_sent_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  payment           Payment?
  doctor            DoctorProfile       @relation(fields: [doctorId], references: [id])
  followUpOf        Appointment?        @relation("AppointmentFollowUp", fields: [followUpOfId], references: [id])
  followUps         Appointment[]       @relation("AppointmentFollowUp")
  patient           Patient             @relation(fields: [patientId], references: [id])
  messages          ChatMessage[]
  consultations     Consultation[]
  serviceId         String?             @map("service_id") @db.Uuid
  serviceName       String?             @map("service_name")
  service           DoctorService?      @relation(fields: [serviceId], references: [id])

  @@index([doctorId, scheduledAt])
  @@index([patientId, scheduledAt])
  @@map("appointments")
}

model Consultation {
  id                    String                 @id @default(uuid()) @db.Uuid
  patientId             String                 @map("patient_id") @db.Uuid
  doctorId              String                 @map("doctor_id") @db.Uuid
  appointmentId         String?                @map("appointment_id") @db.Uuid
  chiefComplaint        String?                @map("chief_complaint")
  historyPresentIllness String?                @map("history_present_illness")
  pastMedicalHistory    String?                @map("past_medical_history")
  symptoms              Json                   @default("[]")
  vitals                Json                   @default("{}")
  examination           String?
  diagnosis             String?
  differentialDiagnosis String?                @map("differential_diagnosis")
  labFindings           String?                @map("lab_findings")
  imagingFindings       String?                @map("imaging_findings")
  treatmentPlan         String?                @map("treatment_plan")
  recommendations       String?
  followUpDate          DateTime?              @map("follow_up_date")
  notes                 String?
  status                ConsultationStatus     @default(DRAFT)
  finalizedAt           DateTime?              @map("finalized_at")
  /// Starts at 1; every amendment of a finalized report increments it.
  revision              Int                    @default(1)
  amendedAt             DateTime?              @map("amended_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  revisions             ConsultationRevision[]
  aiAnalysis            AiAnalysis?
  clinicalNotes         ClinicalNote[]
  /// The single ICD-10 code for this consultation.
  icd                   ConsultationDiagnosis?
  appointment           Appointment?           @relation(fields: [appointmentId], references: [id])
  doctor                DoctorProfile          @relation(fields: [doctorId], references: [id])
  patient               Patient                @relation(fields: [patientId], references: [id])
  prescriptions         Prescription[]
  caseId                String?                @map("case_id") @db.Uuid
  case                  CareCase?              @relation(fields: [caseId], references: [id])

  @@index([patientId])
  @@index([doctorId])
  @@index([doctorId, status, updatedAt])
  @@index([patientId, status, finalizedAt])
  @@map("consultations")
}

model Prescription {
  id                String             @id @default(uuid()) @db.Uuid
  patientId         String             @map("patient_id") @db.Uuid
  doctorId          String             @map("doctor_id") @db.Uuid
  consultationId    String?            @map("consultation_id") @db.Uuid
  status            PrescriptionStatus @default(ACTIVE)
  issuedAt          DateTime           @default(now()) @map("issued_at")
  validUntil        DateTime?          @map("valid_until")
  notes             String?
  /// Timestamp when the prescriber reviewed and confirmed clinical safety alerts.
  safetyReviewedAt  DateTime?          @map("safety_reviewed_at")
  /// Alerts shown at prescribing time and the prescriber's override notes.
  safetyReviewNotes Json?              @map("safety_review_notes")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  items             PrescriptionItem[]
  consultation      Consultation?      @relation(fields: [consultationId], references: [id])
  doctor            DoctorProfile      @relation(fields: [doctorId], references: [id])
  patient           Patient            @relation(fields: [patientId], references: [id])
  caseId            String?            @map("case_id") @db.Uuid
  case              CareCase?          @relation(fields: [caseId], references: [id])

  @@index([patientId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id                     String               @id @default(uuid()) @db.Uuid
  prescriptionId         String               @map("prescription_id") @db.Uuid
  drugName               String
  dose                   String?
  frequency              String?
  duration               String?
  instructions           String?
  // --- Structured clinical fields (enhanced prescribing) ---
  activeIngredient       String?
  drugClass              String?
  pharmacologicalClass   String?
  /// Antibiotic class: penicillins, cephalosporins, macrolides, tetracyclines, fluoroquinolones, aminoglycosides, other.
  antibioticClass        String?
  /// Verified antimicrobial coverage tags, e.g. GRAM_POSITIVE, GRAM_NEGATIVE, BROAD_SPECTRUM, ANAEROBES.
  antimicrobialSpectrum  String[]             @default([]) @map("antimicrobial_spectrum")
  /// Free-text intended bacterial coverage, kept separate from drug class.
  coverageNotes          String?
  indication             String?
  route                  String?
  formulation            String?
  strength               String?
  doseValue              Float?
  doseUnit               String?
  /// Exact administration times, e.g. ["08:00", "20:00"].
  schedule               String[]             @default([])
  frequencyText          String?
  startDate              DateTime?
  endDate                DateTime?
  quantity               Int?
  refills                Int?                 @default(0)
  foodInstructions       String?
  missedDoseInstructions String?
  precautions            String?
  monitoring             String?
  /// Curated medication-reference row used for classification, if any.
  medicationRefId        String?              @map("medication_ref_id") @db.Uuid
  /// Prescriber's documented clinical override of reference data, with reason.
  clinicalOverrideNotes  String?              @map("clinical_override_notes")
  sortOrder              Int                  @default(0)
  medicationRef          MedicationReference? @relation(fields: [medicationRefId], references: [id])
  prescription           Prescription         @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  reminder               MedicationReminder?

  @@index([prescriptionId])
  @@map("prescription_items")
}

model ClinicalNote {
  id               String           @id @default(uuid()) @db.Uuid
  patientId        String           @map("patient_id") @db.Uuid
  authorId         String           @map("author_id") @db.Uuid
  consultationId   String?          @map("consultation_id") @db.Uuid
  type             ClinicalNoteType
  content          String
  visibleToPatient Boolean          @default(false) @map("visible_to_patient")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  author           DoctorProfile    @relation(fields: [authorId], references: [id])
  consultation     Consultation?    @relation(fields: [consultationId], references: [id])
  patient          Patient          @relation(fields: [patientId], references: [id])

  @@index([patientId, createdAt])
  @@map("clinical_notes")
}

/// Documentation scaffolds a clinician saves for reuse: no patient data,
/// only structure (field headings and prompts).
model NoteTemplate {
  id        String            @id @default(uuid()) @db.Uuid
  authorId  String            @map("author_id") @db.Uuid
  name      String
  kind      NoteTemplateKind
  /// JSON object of scaffold fields, e.g. { "history": "...", "examination": "...", "notes": "..." }.
  content   String
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  author    User              @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId, kind])
  @@map("note_templates")
}

enum NoteTemplateKind {
  CONSULTATION
  CASE_NOTE
  REFERRAL
}

/** Kinds of patient documents a facility can customize with a template. */
enum FacilityDocumentTemplateKind {
  LAB_REPORT
  REFERRAL_FORM
  CASE_NOTE
  IMAGING_REPORT
  /// Hospital documents (Module 01) facilities can customize.
  DISCHARGE_SUMMARY
  EPICRISIS
  ADMISSION_NOTE
  PROGRESS_NOTE
  TRANSFER_SUMMARY
  /// Diagnostic-centre documents (Module 03).
  DIAGNOSTIC_REPORT
}

/// Document scaffolds a facility defines for the documents it issues:
/// structure only (field headings and prompts), never patient data.
model FacilityDocumentTemplate {
  id         String                       @id @default(uuid()) @db.Uuid
  facilityId  String                       @map("facility_id") @db.Uuid
  name       String
  kind       FacilityDocumentTemplateKind
  /// JSON object of scaffold fields, e.g. { "findings": "…", "conclusion": "…" }.
  content    String
  createdById String                       @map("created_by_id") @db.Uuid
  createdAt  DateTime                     @default(now()) @map("created_at")
  updatedAt  DateTime                     @updatedAt @map("updated_at")
  facility   LabStaffProfile               @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  createdBy  User                         @relation("FacilityDocumentTemplateAuthor", fields: [createdById], references: [id])

  @@index([facilityId, kind])
  @@map("facility_document_templates")
}

/// Patient reviews of a facility (hospital, laboratory, diagnostic centre).
model FacilityReview {
  id               String          @id @default(uuid()) @db.Uuid
  facilityId       String          @map("facility_id") @db.Uuid
  patientId        String          @map("patient_id") @db.Uuid
  rating           Int
  comment          String?
  moderationStatus ReviewModeration @default(APPROVED) @map("moderation_status")
  moderatedAt     DateTime?
  facilityResponse String?          @map("facility_response")
  respondedAt      DateTime?       @map("responded_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  facility         LabStaffProfile  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  patient          Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, facilityId])
  @@index([facilityId])
  @@map("facility_reviews")
}

model LabTest {
  id          String         @id @default(uuid()) @db.Uuid
  code        String         @unique
  name        String
  category    LabCategory
  unit        String?
  refLow      Float?         @map("ref_low")
  refHigh     Float?         @map("ref_high")
  description String?
  isActive    Boolean        @default(true) @map("is_active")
  orderItems  LabOrderItem[]

  @@index([category])
  @@map("lab_tests")
}

model LabOrder {
  id            String           @id @default(uuid()) @db.Uuid
  patientId     String           @map("patient_id") @db.Uuid
  orderedById   String           @map("ordered_by_id") @db.Uuid
  panelType     String?          @map("panel_type")
  priority      LabOrderPriority @default(ROUTINE)
  status        LabOrderStatus   @default(ORDERED)
  clinicalNotes String?          @map("clinical_notes")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  items         LabOrderItem[]
  orderedBy     User             @relation("LabOrderOrderedBy", fields: [orderedById], references: [id])
  patient       Patient          @relation(fields: [patientId], references: [id])
  results       LabResult[]
  caseId        String?          @map("case_id") @db.Uuid
  case          CareCase?        @relation(fields: [caseId], references: [id])
  /// The hospital facility whose clinician created this order.
  requestingFacilityId   String?          @map("requesting_facility_id") @db.Uuid
  requestingFacility     LabStaffProfile? @relation("LabOrderRequestingFacility", fields: [requestingFacilityId], references: [id])
  /// The laboratory facility responsible for processing this order.
  performingFacilityId   String?          @map("performing_facility_id") @db.Uuid
  performingFacility     LabStaffProfile? @relation("LabOrderPerformingFacility", fields: [performingFacilityId], references: [id])
  specimens             Specimen[]

  @@index([patientId])
  @@index([status])
  @@index([performingFacilityId, status])
  @@index([requestingFacilityId, status])
  @@map("lab_orders")
}

model LabOrderItem {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  labTestId String   @map("lab_test_id") @db.Uuid
  labTest   LabTest  @relation(fields: [labTestId], references: [id])
  order     LabOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, labTestId])
  @@map("lab_order_items")
}

model LabResult {
  id             String           @id @default(uuid()) @db.Uuid
  patientId      String           @map("patient_id") @db.Uuid
  labOrderId     String?          @map("lab_order_id") @db.Uuid
  panelType      String           @map("panel_type")
  category       LabCategory      @default(OTHER)
  testDate       DateTime         @map("test_date") @db.Date
  labName        String?          @map("lab_name")
  interpretation String?
  status         LabResultStatus  @default(PENDING)
  uploadedById   String?          @map("uploaded_by_id") @db.Uuid
  verifiedById   String?          @map("verified_by_id") @db.Uuid
  verifiedAt     DateTime?        @map("verified_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  aiAnalysis     AiAnalysis?
  files          LabResultFile[]
  values         LabResultValue[]
  labOrder       LabOrder?        @relation(fields: [labOrderId], references: [id])
  patient        Patient          @relation(fields: [patientId], references: [id])
  uploadedBy     User?            @relation("LabResultUploadedBy", fields: [uploadedById], references: [id])
  verifiedBy     User?            @relation("LabResultVerifiedBy", fields: [verifiedById], references: [id])
  amendments    LabResultAmendment[]
  criticalAlert CriticalResultAlert?

  @@index([patientId, testDate(sort: Desc)])
  @@index([status])
  @@map("lab_results")
}

model LabResultValue {
  id           String      @id @default(uuid()) @db.Uuid
  resultId     String      @map("result_id") @db.Uuid
  code         String
  name         String
  value        String
  numericValue Float?      @map("numeric_value")
  unit         String?
  refLow       Float?      @map("ref_low")
  refHigh      Float?      @map("ref_high")
  flag         ResultFlag?
  result       LabResult   @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([resultId])
  @@map("lab_result_values")
}

model LabResultFile {
  id         String    @id @default(uuid()) @db.Uuid
  resultId   String    @map("result_id") @db.Uuid
  storageKey String    @unique @map("storage_key")
  fileName   String    @map("file_name")
  mimeType   String    @map("mime_type")
  sizeBytes  Int       @map("size_bytes")
  createdAt  DateTime  @default(now()) @map("created_at")
  result     LabResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([resultId])
  @@map("lab_result_files")
}

model AiAnalysis {
  id               String           @id @default(uuid()) @db.Uuid
  kind             AiAnalysisKind
  labResultId      String?          @unique @map("lab_result_id") @db.Uuid
  medicalHistoryId String?          @unique @map("medical_history_id") @db.Uuid
  consultationId   String?          @unique @map("consultation_id") @db.Uuid
  status           AiAnalysisStatus @default(PENDING)
  reviewStatus     AiReviewStatus   @default(PENDING_REVIEW) @map("review_status")
  reviewedById     String?          @map("reviewed_by_id") @db.Uuid
  reviewedAt       DateTime?        @map("reviewed_at")
  doctorView       Json?            @map("doctor_view")
  patientView      Json?            @map("patient_view")
  flags            Json             @default("[]")
  urgencyLevel     String           @default("routine") @map("urgency_level")
  confidence       Json             @default("{}")
  safetyReport     Json             @default("{}") @map("safety_report")
  model            String?
  metadata         Json             @default("{}")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  consultation     Consultation?    @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  labResult        LabResult?       @relation(fields: [labResultId], references: [id], onDelete: Cascade)
  medicalHistory   MedicalHistory?  @relation(fields: [medicalHistoryId], references: [id], onDelete: Cascade)
  reviewedBy       User?            @relation("AiAnalysisReviewedBy", fields: [reviewedById], references: [id])

  @@index([reviewStatus])
  @@map("ai_analyses")
}

model Conversation {
  id        String        @id @default(uuid()) @db.Uuid
  patientId String        @map("patient_id") @db.Uuid
  doctorId  String        @map("doctor_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at")
  messages  ChatMessage[]
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id])
  patient   Patient       @relation(fields: [patientId], references: [id])

  @@unique([patientId, doctorId])
  @@map("conversations")
}

model ChatMessage {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  appointmentId  String?      @map("appointment_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  type           MessageType  @default(TEXT)
  body           String
  attachmentKey  String?      @map("attachment_key")
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String?
  /// Safe, relative in-app path (e.g. /patient/appointments). Never contains clinical details.
  href      String?
  data      Json?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id       String              @id @default(uuid()) @db.Uuid
  userId   String              @map("user_id") @db.Uuid
  category NotificationType
  channel  NotificationChannel
  enabled  Boolean             @default(true)
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, channel])
  @@map("notification_preferences")
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// One imported release of a clinical code set (e.g. ICD-10, WHO 2019). Exactly one release per system is active.
model CodeSystemRelease {
  id           String                  @id @default(uuid()) @db.Uuid
  system       String
  edition      String
  jurisdiction String
  label        String
  sourceUrl    String?                 @map("source_url")
  codeCount    Int                     @map("code_count")
  isActive     Boolean                 @default(false) @map("is_active")
  importedAt   DateTime                @default(now()) @map("imported_at")
  codes        Icd10Code[]
  diagnoses    ConsultationDiagnosis[]

  @@unique([system, edition, jurisdiction])
  @@index([system, isActive])
  @@map("code_system_releases")
}

model Icd10Code {
  id             String            @id @default(uuid()) @db.Uuid
  releaseId      String            @map("release_id") @db.Uuid
  code           String
  /// Code without the dot, upper-case, for dot-insensitive search (A000 finds A00.0).
  codeNormalized String            @map("code_normalized")
  description    String
  chapter        String?
  chapterTitle   String?           @map("chapter_title")
  block          String?
  parentCode     String?           @map("parent_code")
  /// Only leaf codes can be assigned to a diagnosis.
  isSelectable   Boolean           @default(true) @map("is_selectable")
  release        CodeSystemRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([releaseId, code])
  @@index([releaseId, isSelectable, codeNormalized])
  @@map("icd10_codes")
}

/// The one ICD-10 code of a consultation. Code and description are snapshots, so records stay correct when the code set is updated.
model ConsultationDiagnosis {
  id             String             @id @default(uuid()) @db.Uuid
  consultationId String             @unique @map("consultation_id") @db.Uuid
  releaseId      String?            @map("release_id") @db.Uuid
  code           String
  description    String
  consultation   Consultation       @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  release        CodeSystemRelease? @relation(fields: [releaseId], references: [id])
  isPrimary      Boolean            @default(false) @map("is_primary")
  position       Int                @default(0)

  @@index([code])
  @@map("consultation_diagnoses")
}

/// A priced service offered by a laboratory, diagnostic centre or hospital.
model FacilityService {
  id                      String              @id @default(uuid()) @db.Uuid
  facilityId              String              @map("facility_id") @db.Uuid
  name                    String
  description             String?
  category                ServiceCategory     @default(LAB_TEST)
  price                   Decimal             @db.Decimal(12, 2)
  currency                String              @default("NGN")
  turnaroundHours         Int?                @map("turnaround_hours")
  /// Free-text availability, e.g. "Mon–Sat 8am–4pm" or "Walk-in".
  availability            String?
  isActive                Boolean             @default(true) @map("is_active")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")
  facility                LabStaffProfile     @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  bookings                FacilityBooking[]
  branchLabel             String?             @map("branch_label")
  preparationInstructions String?             @map("preparation_instructions")
  referralRequired        Boolean             @default(false) @map("referral_required")
  homeCollectionAvailable Boolean             @default(false) @map("home_collection_available")
  urgentAvailable         Boolean             @default(false) @map("urgent_available")
  branchId                String?             @map("branch_id") @db.Uuid
  departmentId            String?             @map("department_id") @db.Uuid
  referrals               FacilityReferral[]  @relation("ReferralService")
  branch                  FacilityBranch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department              FacilityDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([facilityId, isActive])
  @@map("facility_services")
}

model FacilityBooking {
  id                  String                       @id @default(uuid()) @db.Uuid
  patientId           String                       @map("patient_id") @db.Uuid
  serviceId           String                       @map("service_id") @db.Uuid
  /// Snapshots, so later edits to the service never change a booking.
  serviceName         String                       @map("service_name")
  amount              Decimal                      @db.Decimal(12, 2)
  currency            String
  preferredAt         DateTime                     @map("preferred_at")
  status              FacilityBookingStatus        @default(REQUESTED)
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")
  patient             Patient                      @relation(fields: [patientId], references: [id])
  service             FacilityService              @relation(fields: [serviceId], references: [id])
  payment             Payment?
  caseId              String?                      @map("case_id") @db.Uuid
  /// The hospital facility that referred the patient for this examination.
  requestingFacilityId String?                     @map("requesting_facility_id") @db.Uuid
  assignedStaffId     String?                      @map("assigned_staff_id") @db.Uuid
  workflowStage       FacilityBookingWorkflowStage @default(BOOKED) @map("workflow_stage")
  workflowUpdatedAt   DateTime?                    @map("workflow_updated_at")
  referralDocumentKey String?                      @map("referral_document_key")
  reportDocumentKey   String?                      @map("report_document_key")
  releasedAt          DateTime?                    @map("released_at")
  case                CareCase?                    @relation(fields: [caseId], references: [id])
  requestingFacility  LabStaffProfile?             @relation("BookingRequestingFacility", fields: [requestingFacilityId], references: [id])
  assignedStaff       FacilityStaff?               @relation("BookingAssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  diagnosticReport    DiagnosticReport?
  diagnosticImages    DiagnosticImage[]

  @@index([patientId, createdAt])
  @@index([serviceId, status])
  @@map("facility_bookings")
}

model Payment {
  id                String              @id @default(uuid()) @db.Uuid
  kind              PaymentKind
  payerId           String              @map("payer_id") @db.Uuid
  payeeId           String              @map("payee_id") @db.Uuid
  appointmentId     String?             @unique @map("appointment_id") @db.Uuid
  facilityBookingId String?             @unique @map("facility_booking_id") @db.Uuid
  /// Generic label shown in lists and receipts, e.g. "Consultation fee". Never clinical detail.
  description       String
  amount            Decimal             @db.Decimal(12, 2)
  currency          String
  method            PaymentMethod?
  status            PaymentStatus       @default(PENDING)
  provider          String
  providerReference String              @unique @map("provider_reference")
  receiptNumber     String?             @unique @map("receipt_number")
  failureReason     String?             @map("failure_reason")
  expiresAt         DateTime?           @map("expires_at")
  paidAt            DateTime?           @map("paid_at")
  refundedAt        DateTime?           @map("refunded_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  payer             User                @relation("PaymentPayer", fields: [payerId], references: [id])
  payee             User                @relation("PaymentPayee", fields: [payeeId], references: [id])
  appointment       Appointment?        @relation(fields: [appointmentId], references: [id])
  facilityBooking   FacilityBooking?    @relation(fields: [facilityBookingId], references: [id])
  events            PaymentEvent[]
  commissionAmount  Decimal?            @map("commission_amount") @db.Decimal(12, 2)
  providerAmount    Decimal?            @map("provider_amount") @db.Decimal(12, 2)
  subaccountCode    String?             @map("subaccount_code")
  chargedReference  String?             @map("charged_reference")
  commissionBps     Int?                @map("commission_bps")
  netAmount         Decimal?            @map("net_amount") @db.Decimal(12, 2)
  settlementMode    SettlementMode?
  caseId            String?             @map("case_id") @db.Uuid
  case              CareCase?           @relation(fields: [caseId], references: [id])
  refund            Refund?
  subscription      DoctorSubscription?

  @@index([payerId, createdAt])
  @@index([payeeId, createdAt])
  @@index([status, expiresAt])
  @@map("payments")
}

/// Append-only trail of everything that happened to a payment (initiation, webhooks, verification, refunds).
model PaymentEvent {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  type      String
  details   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  dedupeKey String?  @unique @map("dedupe_key")

  @@index([paymentId, createdAt])
  @@map("payment_events")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  actorRole    Role?    @map("actor_role")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id") @db.Uuid
  details      Json     @default("{}")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User?    @relation(fields: [userId], references: [id])
  facilityId   String?  @map("facility_id") @db.Uuid
  patientId    String?  @map("patient_id") @db.Uuid
  outcome      String?  @db.VarChar(16)

  @@index([userId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@index([userId, action, createdAt])
  @@map("audit_logs")
}

model Notice {
  id        String   @id @default(uuid()) @db.Uuid
  text      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notices")
}

model Ad {
  id        String      @id @default(uuid()) @db.Uuid
  title     String
  content   String
  placement AdPlacement @default(SIDEBAR)
  active    Boolean     @default(true)
  /// Optional https image shown with the ad (landing-page carousel / banner).
  imageUrl  String?     @map("image_url") @db.VarChar(500)
  /// Optional https destination opened when the ad is clicked.
  linkUrl   String?     @map("link_url") @db.VarChar(500)
  /// Optional schedule: the ad is only shown inside this window.
  startsAt  DateTime?   @map("starts_at")
  endsAt    DateTime?   @map("ends_at")
  /// Lower numbers are shown first.
  sortOrder Int         @default(0) @map("sort_order")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([placement, active, sortOrder])
