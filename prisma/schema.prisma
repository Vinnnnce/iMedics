// ============================================================
// Feature: patient medical records and document sharing
// ============================================================

enum DocumentCategory {
  LAB_REPORT
  DIAGNOSTIC_REPORT
  IMAGING_REPORT
  PRESCRIPTION
  DISCHARGE_SUMMARY
  REFERRAL_LETTER
  VACCINATION_RECORD
  OTHER
}

model PatientDocument {
  id              String           @id @default(uuid()) @db.Uuid
  patientId       String           @map("patient_id") @db.Uuid
  category        DocumentCategory
  title           String           @db.VarChar(200)
  fileName        String
  /// Private S3-style key; never exposed directly. Downloads go through presigned URLs.
  storageKey      String           @unique @map("storage_key")
  mimeType        String           @map("mime_type")
  sizeBytes       Int              @map("size_bytes")
  issuingFacility String?          @map("issuing_facility") @db.VarChar(200)
  /// FK form of issuingFacility: the facility whose staff uploaded the document.
  issuingFacilityId String?         @map("issuing_facility_id") @db.Uuid
  issuedOn        DateTime?        @map("issued_on")
  notes           String?
  uploadedById    String           @map("uploaded_by_id") @db.Uuid
  deletedAt       DateTime?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  patient         Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  uploader        User             @relation("PatientDocumentUploaded", fields: [uploadedById], references: [id])
  issuingFacilityRef LabStaffProfile? @relation("IssuingFacility", fields: [issuingFacilityId], references: [id])
  shares          DocumentShare[]
  facilityShares  DocumentFacilityShare[]

  @@index([patientId, createdAt])
  @@index([issuingFacilityId, createdAt])
  @@map("patient_documents")
}

model DocumentShare {
  id               String          @id @default(uuid()) @db.Uuid
  documentId       String          @map("document_id") @db.Uuid
  sharedWithUserId String          @map("shared_with_user_id") @db.Uuid
  /// Platform role the recipient acts as for this share: DOCTOR, NURSE, HOSPITAL, CAREGIVER.
  role             String          @db.VarChar(20)
  grantedById      String          @map("granted_by_id") @db.Uuid
  grantedAt        DateTime        @default(now()) @map("granted_at")
  revokedAt        DateTime?
  document         PatientDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sharedWithUser   User            @relation("DocumentShareRecipient", fields: [sharedWithUserId], references: [id])

  @@index([sharedWithUserId])
  @@index([documentId])
  @@map("document_shares")
}

// ============================================================
// Feature: medication reminders and dose tracking
// ============================================================

enum DoseStatus {
  SCHEDULED
  ACKNOWLEDGED
  TAKEN
  MISSED
  SKIPPED
}

model MedicationReminder {
  id                 String            @id @default(uuid()) @db.Uuid
  patientId          String            @map("patient_id") @db.Uuid
  /// Linked structured prescription item, when the reminder comes from a prescription.
  prescriptionItemId String?           @unique @map("prescription_item_id") @db.Uuid
  label              String            @db.VarChar(200)
  /// Administration times as "HH:mm" local clinic time, e.g. ["08:00", "20:00"].
  times              String[]          @default([])
  startDate          DateTime          @map("start_date")
  endDate            DateTime?
  active             Boolean           @default(true)
  /// Snooze window offered to the patient, in minutes.
  snoozeMinutes      Int               @default(15) @map("snooze_minutes")
  /// Who configured the reminder (patient or clinician user id).
  createdById        String            @map("created_by_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  patient            Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescriptionItem   PrescriptionItem? @relation(fields: [prescriptionItemId], references: [id], onDelete: SetNull)
  doses              DoseEvent[]

  @@index([patientId, active])
  @@map("medication_reminders")
}

model DoseEvent {
  id             String             @id @default(uuid()) @db.Uuid
  reminderId     String             @map("reminder_id") @db.Uuid
  patientId      String             @map("patient_id") @db.Uuid
  scheduledFor   DateTime           @map("scheduled_for")
  status         DoseStatus         @default(SCHEDULED)
  acknowledgedAt DateTime?          @map("acknowledged_at")
  recordedAt     DateTime?          @map("recorded_at")
  recordedById   String?            @map("recorded_by_id") @db.Uuid
  /// How the status was recorded: PATIENT, CLINICIAN, SNOOZE, SYSTEM_MARK_MISSED.
  recordedVia    String?            @map("recorded_via") @db.VarChar(20)
  notifiedAt     DateTime?          @map("notified_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  reminder       MedicationReminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  patient        Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([reminderId, scheduledFor])
  @@index([patientId, scheduledFor])
  @@map("dose_events")
}

// ============================================================
// Feature: trusted contacts, consent and inactivity monitoring
// ============================================================

enum WelfareAlertStatus {
  PENDING
  SENT
  ACKNOWLEDGED
  ESCALATED
  CANCELLED
  RESOLVED_NO_ACTION
}

model TrustedContact {
  id           String   @id @default(uuid()) @db.Uuid
  patientId    String   @map("patient_id") @db.Uuid
  /// Optional link to a platform account (relative, doctor or nurse).
  userId       String?  @map("user_id") @db.Uuid
  name         String   @db.VarChar(120)
  relationship String   @db.VarChar(60)
  phone        String?  @db.VarChar(40)
  email        String?  @db.VarChar(120)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user         User?    @relation("TrustedContactUser", fields: [userId], references: [id])

  @@index([patientId])
  @@map("trusted_contacts")
}

model InactivityRule {
  id                 String         @id @default(uuid()) @db.Uuid
  patientId          String         @unique @map("patient_id") @db.Uuid
  /// Hours without meaningful authenticated activity before an alert, e.g. 24 or 48.
  thresholdHours     Int            @default(48) @map("threshold_hours")
  /// Minutes the alert stays pending before escalation to the next contact.
  escalationHours    Int?           @map("escalation_hours")
  /// Whether a grace period (confirmation) is required before notifying contacts.
  gracePeriodMinutes Int            @default(0) @map("grace_period_minutes")
  /// Quiet window in minutes from midnight (local), e.g. 1320-420 avoids overnight SMS.
  quietHoursStart    Int?           @map("quiet_hours_start")
  quietHoursEnd      Int?           @map("quiet_hours_end")
  /// Contact ids in priority order: first is primary, second receives escalation.
  contactIds         String[]       @default([]) @map("contact_ids")
  active             Boolean        @default(false)
  /// Explicit, revocable consent record for third-party welfare alerts.
  consentAt          DateTime?      @map("consent_at")
  consentText        String?        @map("consent_text")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  patient            Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  alerts             WelfareAlert[]

  @@map("inactivity_rules")
}

model WelfareAlert {
  id                      String                 @id @default(uuid()) @db.Uuid
  ruleId                  String                 @map("rule_id") @db.Uuid
  status                  WelfareAlertStatus     @default(PENDING)
  triggeredAt             DateTime               @default(now()) @map("triggered_at")
  /// Last activity snapshot used to decide the alert; shown to the contact as "has not checked in".
  lastActivityAt          DateTime               @map("last_activity_at")
  acknowledgedAt          DateTime?
  acknowledgedByContactId String?                @map("acknowledged_by_contact_id") @db.Uuid
  acknowledgedByUserId    String?                @map("acknowledged_by_user_id") @db.Uuid
  resolvedAt              DateTime?
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")
  rule                    InactivityRule         @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  deliveries              WelfareAlertDelivery[]

  @@index([ruleId, status])
  @@map("welfare_alerts")
}

model WelfareAlertDelivery {
  id        String       @id @default(uuid()) @db.Uuid
  alertId   String       @map("alert_id") @db.Uuid
  contactId String       @map("contact_id") @db.Uuid
  /// EMAIL, SMS or IN_APP.
  channel   String       @db.VarChar(10)
  /// QUEUED, SENT, FAILED.
  status    String       @default("QUEUED") @db.VarChar(10)
  attempts  Int          @default(0)
  lastError String?
  sentAt    DateTime?
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  alert     WelfareAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId])
  @@map("welfare_alert_deliveries")
}

// ============================================================
// Modules: Hospital, Laboratory & Diagnostic Centre management
// ============================================================

// ---------- Module 02: specimen management ----------

enum SpecimenStatus {
  /// Registered against an order, waiting for collection.
  PENDING_COLLECTION
  COLLECTED
  RECEIVED
  REJECTED
  /// The specimen was unsuitable; a new collection has been requested.
  RECOLLECTION_REQUESTED
  PROCESSED
}

/// One physical specimen received against a laboratory order. A recollection
/// creates a new row linked to the rejected one, so history is never lost.
model Specimen {
  id             String        @id @default(uuid()) @db.Uuid
  labOrderId     String        @map("lab_order_id") @db.Uuid
  facilityId     String        @map("facility_id") @db.Uuid
  /// Facility-scoped accession number, e.g. "SPC-2026-000123".
  accessionNumber String       @map("accession_number")
  /// Scanable barcode identifier for label printing (unique per facility).
  barcode        String?      @map("barcode")
  specimenType   String?
  status         SpecimenStatus @default(PENDING_COLLECTION)
  collectedAt    DateTime?     @map("collected_at")
  collectedById  String?      @map("collected_by_id") @db.Uuid
  receivedAt     DateTime?     @map("received_at")
  receivedById   String?       @map("received_by_id") @db.Uuid
  /// Mandatory when a specimen is rejected.
  rejectionReason String?
  notes          String?
  /// The rejected specimen this recollection replaces, if any.
  parentSpecimenId String?     @map("parent_specimen_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  labOrder        LabOrder      @relation(fields: [labOrderId], references: [id])
  facility        LabStaffProfile @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  collectedBy     User?         @relation("SpecimenCollectedBy", fields: [collectedById], references: [id])
  receivedBy      User?         @relation("SpecimenReceivedBy", fields: [receivedById], references: [id])
  parentSpecimen  Specimen?     @relation("SpecimenRecollection", fields: [parentSpecimenId], references: [id])
  recollections   Specimen[]    @relation("SpecimenRecollection")

  @@unique([facilityId, accessionNumber])
  @@index([labOrderId])
  @@index([facilityId, status])
  @@map("specimens")
}

/// Per-facility sequence counters for accession numbers (one row per facility).
model FacilityAccessionCounter {
  id       String @id // facility id
  sequence Int    @default(0)

  @@map("facility_accession_counters")
}

// ---------- Module 01: hospital admissions ----------

enum AdmissionStatus {
  ACTIVE
  DISCHARGED
  /// Transferred to another facility; the record stays with its history.
  TRANSFERRED
  CANCELLED
}

enum DischargeDisposition {
  RECOVERED
  IMPROVED
  UNCHANGED
  WORSE
  DECEASED
  REFERRED
}

enum AdmissionNoteType {
  ADMISSION_EXAMINATION
  PHYSICIAN_PROGRESS
  NURSING_OBSERVATION
  SPECIALIST_CONSULTATION
  PROCEDURE_REPORT
}

/// A hospital admission episode (Module 01, Category 03).
model Admission {
  clinicalDocuments   ClinicalDocument[] @relation("ClinicalDocumentAdmission")
  encounter           Encounter?   @relation("EncounterAdmission")
  id                  String       @id @default(uuid()) @db.Uuid
  patientId           String       @map("patient_id") @db.Uuid
  facilityId          String       @map("facility_id") @db.Uuid
  caseId              String?      @map("case_id") @db.Uuid
  admittingDoctorId   String?      @map("admitting_doctor_id") @db.Uuid
  ward                String?
  bed                 String?
  admissionDate       DateTime     @map("admission_date")
  reason              String?
  initialAssessment  String?      @map("initial_assessment")
  /// Current ward/bed when bed management is in use.
  currentWardId   String?  @map("current_ward_id") @db.Uuid
  currentBedId    String?  @map("current_bed_id") @db.Uuid
  workingDiagnosis    String?      @map("working_diagnosis")
  diagnosisCode       String?      @map("diagnosis_code")
  diagnosisName       String?      @map("diagnosis_name")
  status              AdmissionStatus @default(ACTIVE)
  dischargeDate       DateTime?    @map("discharge_date")
  disposition         DischargeDisposition?
  finalDiagnosisCode  String?      @map("final_diagnosis_code")
  finalDiagnosisName  String?      @map("final_diagnosis_name")
  outcome             String?
  /// Final discharge summary (epicrisis).
  epicrisis           String?
  medicationInstructions String?   @map("medication_instructions")
  followUpInstructions   String?  @map("follow_up_instructions")
  dischargedById      String?      @map("discharged_by_id") @db.Uuid
  dischargedAt        DateTime?    @map("discharged_at")
  /// Interfacility transfer target (status TRANSFERRED).
  transferredToFacilityId String? @map("transferred_to_facility_id") @db.Uuid
  transferSummary     String?      @map("transfer_summary")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  patient             Patient      @relation(fields: [patientId], references: [id])
  facility            LabStaffProfile @relation(fields: [facilityId], references: [id])
  case                CareCase?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  admittingDoctor     DoctorProfile? @relation("AdmissionAdmittingDoctor", fields: [admittingDoctorId], references: [id], onDelete: SetNull)
  transferredToFacility LabStaffProfile? @relation("AdmissionTransferredToFacility", fields: [transferredToFacilityId], references: [id])
  notes               AdmissionNote[]
  wardTransfers       WardTransfer[]
  currentBed          Bed?         @relation("AdmissionCurrentBed")
  bedReservedFor     Bed?         @relation("BedReservedForAdmission")

  @@index([facilityId, status])
  @@index([patientId, admissionDate(sort: Desc)])
  @@map("admissions")
}

/// Daily progress and observation notes on an admission. Vitals are stored as a
/// JSON object (temperature, pulse, blood pressure, etc.) alongside free text.
model AdmissionNote {
  id           String          @id @default(uuid()) @db.Uuid
  admissionId  String          @map("admission_id") @db.Uuid
  authorId     String          @map("author_id") @db.Uuid
  type         AdmissionNoteType
  content      String
  vitals       Json?
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  admission    Admission       @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  author       User            @relation(fields: [authorId], references: [id])

  @@index([admissionId, createdAt])
  @@map("admission_notes")
}

/// Internal ward-to-ward transfer inside the same hospital.
model WardTransfer {
  id           String   @id @default(uuid()) @db.Uuid
  admissionId  String   @map("admission_id") @db.Uuid
  fromWard    String?
  toWard      String
  /// Bed records involved when bed management is in use.
  fromBedId   String?  @map("from_bed_id") @db.Uuid
  toBedId     String?  @map("to_bed_id") @db.Uuid
  reason      String?
  actorId     String   @map("actor_id") @db.Uuid
  transferredAt DateTime @map("transferred_at")
  createdAt    DateTime @default(now()) @map("created_at")
  admission    Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  actor        User     @relation(fields: [actorId], references: [id])
  fromBed      Bed?     @relation("WardTransferFromBed", fields: [fromBedId], references: [id], onDelete: SetNull)
  toBed        Bed?     @relation("WardTransferToBed", fields: [toBedId], references: [id], onDelete: SetNull)

  @@index([admissionId, transferredAt])
  @@map("ward_transfers")
}

// ---------- Ward & bed management ----------

/// A hospital ward configured by the facility. Beds belong to wards.
model Ward {
  id           String   @id @default(uuid()) @db.Uuid
  facilityId   String   @map("facility_id") @db.Uuid
  name         String
  code         String?  @db.VarChar(40)
  departmentId String?  @map("department_id") @db.Uuid
  /// MALE | FEMALE | MIXED | PEDIATRIC | ISOLATION
  genderPolicy String?  @db.VarChar(20)
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  beds Bed[]
  facility   LabStaffProfile @relation("WardFacility", fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, name])
  @@index([facilityId])
  @@map("wards")
}

/// A physical bed. One active admission occupies a bed; reservations are
/// time-limited; cleaning and maintenance states keep the lifecycle auditable.
model Bed {
  id                     String       @id @default(uuid()) @db.Uuid
  facilityId             String       @map("facility_id") @db.Uuid
  wardId                 String       @map("ward_id") @db.Uuid
  label                  String
  /// AVAILABLE | OCCUPIED | RESERVED | CLEANING | MAINTENANCE | ISOLATION
  status                 String       @default("AVAILABLE") @db.VarChar(20)
  /// Set while a bed is blocked for infection control.
  isolationReason        String?      @db.VarChar(200)
  reservedForAdmissionId String?      @unique @map("reserved_for_admission_id") @db.Uuid
  reservedUntil          DateTime?    @map("reserved_until")
  currentAdmissionId     String?      @unique @map("current_admission_id") @db.Uuid
  cleanedAt              DateTime?    @map("cleaned_at")
  notes                  String?
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  ward                   Ward         @relation(fields: [wardId], references: [id], onDelete: Cascade)
  facility               LabStaffProfile @relation("BedFacility", fields: [facilityId], references: [id], onDelete: Cascade)
  currentAdmission       Admission?  @relation("AdmissionCurrentBed", fields: [currentAdmissionId], references: [id])
  reservedForAdmission   Admission?   @relation("BedReservedForAdmission", fields: [reservedForAdmissionId], references: [id])
  transferFrom           WardTransfer[] @relation("WardTransferFromBed")
  transferTo             WardTransfer[] @relation("WardTransferToBed")

  @@unique([wardId, label])
  @@index([facilityId, status])
  @@map("beds")
}

// ---------- Module 03: diagnostic reports ----------

enum DiagnosticReportStatus {
  DRAFT
  AWAITING_VERIFICATION
  FINALIZED
  SENT
  AMENDED
}

/// The examination report for a diagnostic booking. Finalized reports are
/// immutable: corrections go through DiagnosticReportVersion amendments.
model DiagnosticReport {
  id                        String   @id @default(uuid()) @db.Uuid
  bookingId                 String   @unique @map("booking_id") @db.Uuid
  facilityId                String   @map("facility_id") @db.Uuid
  status                    DiagnosticReportStatus @default(DRAFT)
  preliminaryFindings       String?  @map("preliminary_findings")
  specialistInterpretation  String?  @map("specialist_interpretation")
  recommendations           String?
  draftedById               String?  @map("drafted_by_id") @db.Uuid
  verifiedById              String?  @map("verified_by_id") @db.Uuid
  verifiedAt                DateTime? @map("verified_at")
  signedById                String?  @map("signed_by_id") @db.Uuid
  signedAt                  DateTime? @map("signed_at")
  finalizedAt               DateTime? @map("finalized_at")
  sentAt                    DateTime? @map("sent_at")
  sentToFacilityId          String?  @map("sent_to_facility_id") @db.Uuid
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")
  booking                   FacilityBooking @relation(fields: [bookingId], references: [id])
  facility                  LabStaffProfile @relation(fields: [facilityId], references: [id])
  draftedBy                 User?    @relation("DiagnosticReportDraftedBy", fields: [draftedById], references: [id])
  verifiedBy                User?    @relation("DiagnosticReportVerifiedBy", fields: [verifiedById], references: [id])
  signedBy                  User?    @relation("DiagnosticReportSignedBy", fields: [signedById], references: [id])
  sentToFacility            LabStaffProfile? @relation("DiagnosticReportSentToFacility", fields: [sentToFacilityId], references: [id])
  versions                  DiagnosticReportVersion[]
  images                    DiagnosticImage[]

  @@index([facilityId, status])
  @@map("diagnostic_reports")
}

/// Immutable version snapshots of a diagnostic report. Version 1 is the
/// finalized original; every amendment appends a new version with a reason.
model DiagnosticReportVersion {
  id          String   @id @default(uuid()) @db.Uuid
  reportId    String   @map("report_id") @db.Uuid
  version     Int
  snapshot    Json
  reason      String?
  changedById String   @map("changed_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  report      DiagnosticReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  changedBy   User     @relation("DiagnosticReportVersionBy", fields: [changedById], references: [id])

  @@unique([reportId, version])
  @@map("diagnostic_report_versions")
}

/// Imaging attachments for a diagnostic examination. Files live in private
/// object storage; only the storage key is persisted here.
model DiagnosticImage {
  id           String   @id @default(uuid()) @db.Uuid
  reportId     String?  @map("report_id") @db.Uuid
  bookingId    String   @map("booking_id") @db.Uuid
  storageKey   String   @unique @map("storage_key")
  fileName     String   @map("file_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  report       DiagnosticReport? @relation(fields: [reportId], references: [id])
  booking      FacilityBooking @relation(fields: [bookingId], references: [id])
  uploadedBy   User     @relation("DiagnosticImageUploadedBy", fields: [uploadedById], references: [id])

  @@index([bookingId])
  @@map("diagnostic_images")
}

// ---------- Cross-module: amendments and critical alerts ----------

/// Auditable amendment of a verified lab result. The previous content is
/// snapshotted; the original record is never silently overwritten.
model LabResultAmendment {
  id               String   @id @default(uuid()) @db.Uuid
  labResultId      String   @map("lab_result_id") @db.Uuid
  reason           String
  previousSnapshot Json     @map("previous_snapshot")
  changedById      String   @map("changed_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  labResult        LabResult @relation(fields: [labResultId], references: [id])
  changedBy        User     @relation("LabResultAmendedBy", fields: [changedById], references: [id])

  @@index([labResultId, createdAt])
  @@map("lab_result_amendments")
}

enum CriticalAlertStatus {
  SENT
  ACKNOWLEDGED
  ESCALATED
  RESOLVED
}

/// A critical lab finding that must be communicated to the ordering clinician
/// and acknowledged. Unacknowledged alerts escalate.
model CriticalResultAlert {
  id                  String   @id @default(uuid()) @db.Uuid
  labResultId         String   @unique @map("lab_result_id") @db.Uuid
  labOrderId          String?   @map("lab_order_id") @db.Uuid
  patientId           String   @map("patient_id") @db.Uuid
  /// The hospital facility that ordered the investigation, when applicable.
  orderingFacilityId  String?   @map("ordering_facility_id") @db.Uuid
  notifiedUserId      String?
  status              CriticalAlertStatus @default(SENT)
  acknowledgedById    String?  @map("acknowledged_by_id") @db.Uuid
  acknowledgedAt      DateTime?
  escalatedAt         DateTime?
  escalationLevel     Int      @default(0) @map("escalation_level")
  note                String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  labResult           LabResult @relation(fields: [labResultId], references: [id])
  patient             Patient  @relation(fields: [patientId], references: [id])
  orderingFacility    LabStaffProfile? @relation("CriticalAlertOrderingFacility", fields: [orderingFacilityId], references: [id])
  acknowledgedBy      User?    @relation("CriticalAlertAcknowledgedBy", fields: [acknowledgedById], references: [id])

  @@index([status])
  @@index([orderingFacilityId, status])
  @@map("critical_result_alerts")
}

// ============================================================
// Hospital Information System (HIS) foundations
// Multi-hospital configuration, versioned clinical document templates,
// clinical documents with signatures/amendments, encounters and operational
// priority, payer classification, and diagnostic media. Every row is scoped
// to a facility (tenant); queries always filter by facility id.
// ============================================================

/// Per-hospital configuration (branding, numbering, terminology, release
/// policy). Every change is snapshotted in HospitalSettingsRevision.
model HospitalSettings {
  id                          String                     @id @default(uuid()) @db.Uuid
  facilityId                  String                     @unique @map("facility_id") @db.Uuid
  displayName                 String?                    @map("display_name") @db.VarChar(200)
  letterheadLines             String[]                   @default([]) @map("letterhead_lines")
  logoUrl                     String?                    @map("logo_url") @db.VarChar(500)
  addressLine                 String?                    @map("address_line") @db.VarChar(300)
  contactPhone                String?                    @map("contact_phone") @db.VarChar(40)
  contactEmail                String?                    @map("contact_email") @db.VarChar(120)
  defaultLanguage             String                     @default("en") @map("default_language") @db.VarChar(10)
  dateFormat                  String                     @default("dd/MM/yyyy") @map("date_format") @db.VarChar(20)
  timeZone                    String                     @default("Africa/Lagos") @map("time_zone") @db.VarChar(60)
  documentNumberPrefix        String                     @default("DOC") @map("document_number_prefix") @db.VarChar(12)
  pageSize                    String                     @default("A4") @map("page_size") @db.VarChar(10)
  footerText                  String?                    @map("footer_text") @db.VarChar(300)
  /// Optional HIS modules this hospital uses (e.g. EMERGENCY, SURGERY, INSURANCE).
  enabledModules              String[]                   @default([]) @map("enabled_modules")
  /// Hospital-specific terminology overrides, e.g. { "ward": "Unit" }.
  terminology                 Json                       @default("{}")
  /// Approved triage protocol name and its categories (local protocol only).
  triageProtocol              String?                    @map("triage_protocol") @db.VarChar(120)
  triageCategories            String[]                   @default([]) @map("triage_categories")
  /// Minutes without a workflow update before an encounter is flagged overdue.
  overdueMinutes              Int                        @default(60) @map("overdue_minutes")
  /// When true, template approval must be done by someone other than the last editor.
  independentTemplateApproval Boolean                    @default(true) @map("independent_template_approval")
  /// Retention category label applied to documents by default (policy text lives with the hospital).
  defaultRetentionCategory    String                     @default("STANDARD") @map("default_retention_category") @db.VarChar(40)
  version                     Int                        @default(1)
  updatedById                 String?                    @map("updated_by_id") @db.Uuid
  createdAt                   DateTime                   @default(now()) @map("created_at")
  updatedAt                   DateTime                   @updatedAt @map("updated_at")
  facility                    LabStaffProfile            @relation("HospitalSettingsFacility", fields: [facilityId], references: [id], onDelete: Cascade)
  revisions                   HospitalSettingsRevision[]

  @@map("hospital_settings")
}

model HospitalSettingsRevision {
  id          String           @id @default(uuid()) @db.Uuid
  settingsId  String           @map("settings_id") @db.Uuid
  version     Int
  snapshot    Json
  changedById String?          @map("changed_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")
  settings    HospitalSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@unique([settingsId, version])
  @@map("hospital_settings_revisions")
}

enum TemplateLifecycle {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  RETIRED
}

/// A hospital's own document type. Cloned from the system catalogue or created
/// from scratch; never shared between hospitals.
model ClinicalDocumentTemplate {
  id               String                            @id @default(uuid()) @db.Uuid
  facilityId       String                            @map("facility_id") @db.Uuid
  /// Stable per-hospital code, e.g. "B.21-outpatient-clinical-summary".
  code             String                            @db.VarChar(120)
  /// Catalogue group letter (A–P) or CUSTOM.
  groupCode        String                            @map("group_code") @db.VarChar(10)
  name             String                            @db.VarChar(200)
  description      String?
  /// System catalogue code this template was cloned from, if any.
  sourceCode       String?                           @map("source_code") @db.VarChar(120)
  departments      String[]                          @default([])
  specialty        String?                           @db.VarChar(80)
  /// Version number currently used for new documents (null until first publication).
  publishedVersion Int?                              @map("published_version")
  retiredAt        DateTime?                         @map("retired_at")
  createdById      String                            @map("created_by_id") @db.Uuid
  createdAt        DateTime                          @default(now()) @map("created_at")
  updatedAt        DateTime                          @updatedAt @map("updated_at")
  facility         LabStaffProfile                   @relation("ClinicalTemplateFacility", fields: [facilityId], references: [id], onDelete: Cascade)
  versions         ClinicalDocumentTemplateVersion[]

  @@unique([facilityId, code])
  @@index([facilityId, groupCode])
  @@map("clinical_document_templates")
}

/// Immutable once published: the definition documents were written against.
model ClinicalDocumentTemplateVersion {
  id            String                   @id @default(uuid()) @db.Uuid
  templateId    String                   @map("template_id") @db.Uuid
  version       Int
  status        TemplateLifecycle        @default(DRAFT)
  /// Sections, fields, signature rules, permissions and output settings (validated JSON).
  definition    Json
  changeNote    String?                  @map("change_note") @db.VarChar(500)
  editedById    String                   @map("edited_by_id") @db.Uuid
  submittedAt   DateTime?                @map("submitted_at")
  approvedById  String?                  @map("approved_by_id") @db.Uuid
  approvedAt    DateTime?                @map("approved_at")
  publishedById String?                  @map("published_by_id") @db.Uuid
  publishedAt   DateTime?                @map("published_at")
  retiredAt     DateTime?                @map("retired_at")
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")
  template      ClinicalDocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  documents     ClinicalDocument[]

  @@unique([templateId, version])
  @@index([status])
  @@map("clinical_document_template_versions")
}

enum ClinicalDocumentStatus {
  DRAFT
  PENDING_REVIEW
  PENDING_SIGNATURE
  FINAL
  /// Superseded by a finalized amendment (kept unchanged for the record).
  AMENDED
  ENTERED_IN_ERROR
}

enum DocumentSensitivity {
  STANDARD
  RESTRICTED
  /// Mental health, genetic, infectious disease, safeguarding, etc.
  SPECIALLY_PROTECTED
}

model ClinicalDocument {
  id                  String                          @id @default(uuid()) @db.Uuid
  facilityId          String                          @map("facility_id") @db.Uuid
  patientId           String                          @map("patient_id") @db.Uuid
  encounterId         String?                         @map("encounter_id") @db.Uuid
  admissionId         String?                         @map("admission_id") @db.Uuid
  templateVersionId   String                          @map("template_version_id") @db.Uuid
  /// Facility-scoped unique number, e.g. "DOC-2026-000123".
  documentNumber      String                          @map("document_number") @db.VarChar(40)
  title               String                          @db.VarChar(200)
  groupCode           String                          @map("group_code") @db.VarChar(10)
  department          String?                         @db.VarChar(120)
  status              ClinicalDocumentStatus          @default(DRAFT)
  sensitivity         DocumentSensitivity             @default(STANDARD)
  /// Field values keyed by field id.
  content             Json                            @default("{}")
  /// SHA-256 of the canonical content, set on finalization; signatures bind to it.
  contentHash         String?                         @map("content_hash") @db.VarChar(64)
  /// Amendment chain: 1 for originals, +1 for each amendment.
  revision            Int                             @default(1)
  supersedesId        String?                         @unique @map("supersedes_id") @db.Uuid
  amendmentReason     String?                         @map("amendment_reason")
  authorId            String                          @map("author_id") @db.Uuid
  reviewedById        String?                         @map("reviewed_by_id") @db.Uuid
  reviewedAt          DateTime?                       @map("reviewed_at")
  finalizedAt         DateTime?                       @map("finalized_at")
  releasedToPatientAt DateTime?                       @map("released_to_patient_at")
  releasedById        String?                         @map("released_by_id") @db.Uuid
  voidReason          String?                         @map("void_reason")
  createdAt           DateTime                        @default(now()) @map("created_at")
  updatedAt           DateTime                        @updatedAt @map("updated_at")
  facility            LabStaffProfile                 @relation("ClinicalDocumentFacility", fields: [facilityId], references: [id])
  patient             Patient                         @relation("ClinicalDocumentPatient", fields: [patientId], references: [id])
  encounter           Encounter?                      @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  admission           Admission?                      @relation("ClinicalDocumentAdmission", fields: [admissionId], references: [id], onDelete: SetNull)
  templateVersion     ClinicalDocumentTemplateVersion @relation(fields: [templateVersionId], references: [id])
  author              User                            @relation("ClinicalDocumentAuthor", fields: [authorId], references: [id])
  supersedes          ClinicalDocument?               @relation("ClinicalDocumentAmendment", fields: [supersedesId], references: [id])
  supersededBy        ClinicalDocument?               @relation("ClinicalDocumentAmendment")
  signatures          DocumentSignature[]
  events              ClinicalDocumentEvent[]

  @@unique([facilityId, documentNumber])
  @@index([facilityId, status])
  @@index([patientId, createdAt(sort: Desc)])
  @@map("clinical_documents")
}

enum SignatureRole {
  AUTHOR
  CO_SIGNER
  REVIEWER
  VERIFIER
  DEPARTMENT_HEAD
  PATIENT
  AUTHORIZED_REPRESENTATIVE
  CLINICIAN_OBTAINING_CONSENT
  WITNESS
  INTERPRETER
}

enum SignatureMethod {
  /// Signed in-app by the authenticated signer themselves.
  AUTHENTICATED_ELECTRONIC
  /// Wet-ink signature on paper; recorded and attested by an authenticated staff member.
  HANDWRITTEN_ATTESTED
}

/// A signature actually given by a real person. Never generated automatically.
model DocumentSignature {
  id              String           @id @default(uuid()) @db.Uuid
  documentId      String           @map("document_id") @db.Uuid
  role            SignatureRole
  method          SignatureMethod
  /// Platform user who signed (electronic) or who attested a handwritten signature.
  signerUserId    String?          @map("signer_user_id") @db.Uuid
  attestedById    String?          @map("attested_by_id") @db.Uuid
  signerName      String           @map("signer_name") @db.VarChar(160)
  signerTitle     String?          @map("signer_title") @db.VarChar(160)
  registrationId  String?          @map("registration_id") @db.VarChar(80)
  relationship    String?          @db.VarChar(80)
  /// Content hash and template version the signature applies to.
  contentHash     String           @map("content_hash") @db.VarChar(64)
  templateVersion Int              @map("template_version")
  signedAt        DateTime         @default(now()) @map("signed_at")
  revokedAt       DateTime?        @map("revoked_at")
  revokedReason   String?          @map("revoked_reason")
  document        ClinicalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_signatures")
}

/// Workflow trail per document (create, save, submit, review, sign, finalize,
/// amend, release, print, download). Complements the platform audit log.
model ClinicalDocumentEvent {
  id         String           @id @default(uuid()) @db.Uuid
  documentId String           @map("document_id") @db.Uuid
  action     String           @db.VarChar(40)
  actorId    String?          @map("actor_id") @db.Uuid
  note       String?
  snapshot   Json?
  createdAt  DateTime         @default(now()) @map("created_at")
  document   ClinicalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@map("clinical_document_events")
}

/// Per-facility, per-year sequence counters (document numbers, encounter numbers).
model FacilitySequence {
  facilityId String @map("facility_id") @db.Uuid
  name       String @db.VarChar(30)
  year       Int
  value      Int    @default(0)

  @@id([facilityId, name, year])
  @@map("facility_sequences")
}

enum RegistrationDraftStatus {
  DRAFT
  COMPLETED
  DISCARDED
}

/// An incomplete registration workspace saved by authorised staff. The payload
/// is the full stepper form state (JSON) so the form can evolve without schema
/// churn. Completed drafts are retained for audit and traceability.
model RegistrationDraft {
  id          String               @id @default(uuid()) @db.Uuid
  facilityId  String               @map("facility_id") @db.Uuid
  createdById String               @map("created_by_id") @db.Uuid
  status      RegistrationDraftStatus @default(DRAFT)
  label       String               @db.VarChar(160)
  payload     Json
  /// Set once the draft is completed — traceability of the produced record.
  patientId   String?              @map("patient_id") @db.Uuid
  encounterId String?              @map("encounter_id") @db.Uuid
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  facility    LabStaffProfile      @relation("RegistrationDraftFacility", fields: [facilityId], references: [id])
  createdBy   User                 @relation("RegistrationDraftAuthor", fields: [createdById], references: [id])
  patient     Patient?             @relation("RegistrationDraftPatient", fields: [patientId], references: [id], onDelete: SetNull)
  encounter   Encounter?           @relation("RegistrationDraftEncounter", fields: [encounterId], references: [id], onDelete: SetNull)

  @@index([facilityId, status])
  @@index([createdById])
  @@map("registration_drafts")
}

enum CarePriority {
  EMERGENCY
  URGENT
  SEMI_URGENT
  ROUTINE
  ELECTIVE
}

enum EncounterType {
  EMERGENCY_DEPARTMENT
  UNSCHEDULED_OUTPATIENT
  SCHEDULED_OUTPATIENT
  PLANNED_INPATIENT
  EMERGENCY_INPATIENT
  DAY_SURGERY
  PLANNED_PROCEDURE
  EMERGENCY_PROCEDURE
  OBSERVATION
  TRANSFER_IN
  FOLLOW_UP
  OTHER
}

enum EncounterWorkflowStatus {
  REGISTERED
  AWAITING_TRIAGE
  TRIAGED
  AWAITING_CLINICIAN
  UNDER_ASSESSMENT
  AWAITING_INVESTIGATIONS
  AWAITING_SPECIALIST
  AWAITING_TREATMENT
  AWAITING_ADMISSION
  ADMITTED
  IN_PROCEDURE
  RECOVERING
  AWAITING_DISCHARGE
  DISCHARGED
  TRANSFERRED
  CANCELLED
  DID_NOT_ATTEND
}

/// A patient visit/episode at one hospital. Care priority (administrative
/// urgency) is kept separate from the encounter type and from clinical triage.
model Encounter {
  id              String                  @id @default(uuid()) @db.Uuid
  facilityId      String                  @map("facility_id") @db.Uuid
  patientId       String                  @map("patient_id") @db.Uuid
  encounterNumber String                  @map("encounter_number") @db.VarChar(40)
  type            EncounterType
  priority        CarePriority            @default(ROUTINE)
  status          EncounterWorkflowStatus @default(REGISTERED)
  department      String?                 @db.VarChar(120)
  clinicianName   String?                 @map("clinician_name") @db.VarChar(160)
  chiefComplaint  String?                 @map("chief_complaint")
  /// Category from the hospital's approved local triage protocol (null until triaged).
  triageCategory  String?                 @map("triage_category") @db.VarChar(60)
  triageProtocol  String?                 @map("triage_protocol") @db.VarChar(120)
  triagedById     String?                 @map("triaged_by_id") @db.Uuid
  triagedAt       DateTime?               @map("triaged_at")
  admissionId     String?                 @unique @map("admission_id") @db.Uuid
  /// Payer coverage that applied to this encounter (history preserved even if the patient's classification changes).
  coverageId      String?                 @map("coverage_id") @db.Uuid
  payerCategory   PayerCategory?          @map("payer_category")
  /// Emergency-department encounter (Module 04). Triage fields above apply.
  isEmergency      Boolean                @default(false) @map("is_emergency")
  /// AMBULANCE | WALK_IN | REFERRAL | TRANSFER
  arrivalMode      String?                @map("arrival_mode") @db.VarChar(20)
  referralSource   String?                @map("referral_source") @db.VarChar(160)
  /// Set while the patient is unidentified; the record is reconciled later.
  temporaryLabel   String?                @map("temporary_label") @db.VarChar(80)
  /// Triage-scheduled reassessment time (clinical safety).
  reassessmentDueAt DateTime?            @map("reassessment_due_at")
  /// Initial emergency observations recorded at registration (JSON vitals).
  initialObservations Json?               @map("initial_observations")
  /// Consent acknowledgements captured at registration:
  /// [{key,title,version,status,signedByRole,capturedByName,capturedAt,withdrawnAt}]
  consents          Json?                  @map("consents")
  /// Known allergies captured during emergency registration.
  knownAllergies    String?               @map("known_allergies")
  registeredAt    DateTime                @default(now()) @map("registered_at")
  statusChangedAt DateTime                @default(now()) @map("status_changed_at")
  closedAt        DateTime?               @map("closed_at")
  createdById     String                  @map("created_by_id") @db.Uuid
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  facility        LabStaffProfile         @relation("EncounterFacility", fields: [facilityId], references: [id])
  patient         Patient                 @relation("EncounterPatient", fields: [patientId], references: [id])
  admission       Admission?              @relation("EncounterAdmission", fields: [admissionId], references: [id], onDelete: SetNull)
  coverage        PayerCoverage?          @relation(fields: [coverageId], references: [id], onDelete: SetNull)
  events          EncounterStatusEvent[]
  documents       ClinicalDocument[]
  media           MedicalMedia[]
  registrationDrafts RegistrationDraft[] @relation("RegistrationDraftEncounter")

  @@unique([facilityId, encounterNumber])
  @@index([facilityId, status])
  @@index([facilityId, priority])
  @@index([patientId, registeredAt(sort: Desc)])
  @@map("encounters")
}

model EncounterStatusEvent {
  id          String                   @id @default(uuid()) @db.Uuid
  encounterId String                   @map("encounter_id") @db.Uuid
  fromStatus  EncounterWorkflowStatus? @map("from_status")
  toStatus    EncounterWorkflowStatus  @map("to_status")
  priority    CarePriority?
  note        String?
  actorId     String?                  @map("actor_id") @db.Uuid
  createdAt   DateTime                 @default(now()) @map("created_at")
  encounter   Encounter                @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId, createdAt])
  @@map("encounter_status_events")
}

enum PayerCategory {
  PUBLIC_INSURANCE
  PRIVATE_INSURANCE
  EMPLOYER_SPONSORED
  GOVERNMENT_SUBSIDIZED
  INTERNATIONAL_INSURANCE
  TRAVEL_INSURANCE
  SELF_PAY
  UNINSURED
  CHARITY
  OTHER
}

enum CoverageEligibility {
  NOT_VERIFIED
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum ClaimStatus {
  NOT_SUBMITTED
  SUBMITTED
  IN_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  PAID
}

/// A patient's payer arrangement at one hospital. Coverage is recorded and
/// verified by staff — never inferred from demographics. Ended rows are kept.
model PayerCoverage {
  id                    String                 @id @default(uuid()) @db.Uuid
  facilityId            String                 @map("facility_id") @db.Uuid
  patientId             String                 @map("patient_id") @db.Uuid
  category              PayerCategory
  /// 1 = primary, 2 = secondary.
  rank                  Int                    @default(1)
  providerName          String?                @map("provider_name") @db.VarChar(160)
  planName              String?                @map("plan_name") @db.VarChar(160)
  /// Restricted: masked in lists, shown in full only to MANAGE_INSURANCE.
  memberNumber          String?                @map("member_number") @db.VarChar(80)
  coverageStart         DateTime?              @map("coverage_start") @db.Date
  coverageEnd           DateTime?              @map("coverage_end") @db.Date
  eligibility           CoverageEligibility    @default(NOT_VERIFIED)
  benefitNotes          String?                @map("benefit_notes")
  referralRequired      Boolean                @default(false) @map("referral_required")
  preauthRequired       Boolean                @default(false) @map("preauth_required")
  authorizationNumber   String?                @map("authorization_number") @db.VarChar(80)
  authorizationExpires  DateTime?              @map("authorization_expires") @db.Date
  claimStatus           ClaimStatus            @default(NOT_SUBMITTED) @map("claim_status")
  billingResponsibility String?                @map("billing_responsibility") @db.VarChar(160)
  copayKobo             Int?                   @map("copay_kobo")
  outOfPocketKobo       Int?                   @map("out_of_pocket_kobo")
  active                Boolean                @default(true)
  endedAt               DateTime?              @map("ended_at")
  endedReason           String?                @map("ended_reason")
  createdById           String                 @map("created_by_id") @db.Uuid
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  facility              LabStaffProfile        @relation("PayerCoverageFacility", fields: [facilityId], references: [id])
  patient               Patient                @relation("PayerCoveragePatient", fields: [patientId], references: [id])
  verifications         CoverageVerification[]
  encounters            Encounter[]

  @@index([facilityId, active, category])
  @@index([patientId])
  @@map("payer_coverages")
}

model CoverageVerification {
  id          String              @id @default(uuid()) @db.Uuid
  coverageId  String              @map("coverage_id") @db.Uuid
  eligibility CoverageEligibility
  claimStatus ClaimStatus?        @map("claim_status")
  note        String?
  actorId     String              @map("actor_id") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at")
  coverage    PayerCoverage       @relation(fields: [coverageId], references: [id], onDelete: Cascade)

  @@index([coverageId, createdAt])
  @@map("coverage_verifications")
}

enum MediaCategory {
  XRAY
  CT
  MRI
  ULTRASOUND
  ECHOCARDIOGRAPHY
  ECG_HOLTER
  EEG
  ENDOSCOPY
  GASTROSCOPY
  COLONOSCOPY
  ANGIOGRAPHY
  MAMMOGRAPHY
  DOPPLER
  FLUOROSCOPY
  NUCLEAR_MEDICINE
  PULMONARY_FUNCTION
  LABORATORY_REPORT
  PATHOLOGY_HISTOLOGY
  MICROBIOLOGY
  AUDIOLOGY
  OPHTHALMIC
  PRESSURE_THERAPY
  REHABILITATION
  OTHER
}

enum MediaReportStatus {
  UNREPORTED
  PRELIMINARY
  VERIFIED
  AMENDED
}

enum MediaScanStatus {
  /// No malware scanner configured — the file passed signature checks only.
  NOT_SCANNED
  CLEAN
  INFECTED
}

/// A diagnostic file (image, video, waveform, report, interoperability
/// message) attached to a patient and optionally an encounter. Binary content
/// lives in private object storage; only metadata and the key are stored here.
model MedicalMedia {
  id                  String              @id @default(uuid()) @db.Uuid
  facilityId          String              @map("facility_id") @db.Uuid
  patientId           String              @map("patient_id") @db.Uuid
  encounterId         String?             @map("encounter_id") @db.Uuid
  category            MediaCategory
  /// Distinguishes diagnostic results from treatment/therapy documentation.
  isTherapyRecord     Boolean             @default(false) @map("is_therapy_record")
  examinationType     String              @map("examination_type") @db.VarChar(160)
  examinationAt       DateTime?           @map("examination_at")
  department          String?             @db.VarChar(120)
  orderingClinician   String?             @map("ordering_clinician") @db.VarChar(160)
  performingFacility  String?             @map("performing_facility") @db.VarChar(200)
  reportingClinician  String?             @map("reporting_clinician") @db.VarChar(160)
  reportStatus        MediaReportStatus   @default(UNREPORTED) @map("report_status")
  modality            String?             @db.VarChar(40)
  device              String?             @db.VarChar(160)
  bodySite            String?             @map("body_site") @db.VarChar(120)
  contrastDetails     String?             @map("contrast_details") @db.VarChar(300)
  accessionNumber     String?             @map("accession_number") @db.VarChar(80)
  studyInstanceUid    String?             @map("study_instance_uid") @db.VarChar(128)
  externalReference   String?             @map("external_reference") @db.VarChar(160)
  relatedOrderRef     String?             @map("related_order_ref") @db.VarChar(80)
  fileName            String              @map("file_name") @db.VarChar(200)
  formatKey           String              @map("format_key") @db.VarChar(30)
  mimeType            String              @map("mime_type") @db.VarChar(100)
  sizeBytes           BigInt              @map("size_bytes")
  sha256              String              @db.VarChar(64)
  storageKey          String              @unique @map("storage_key")
  scanStatus          MediaScanStatus     @default(NOT_SCANNED) @map("scan_status")
  sensitivity         DocumentSensitivity @default(STANDARD)
  retentionCategory   String              @default("STANDARD") @map("retention_category") @db.VarChar(40)
  releasedToPatientAt DateTime?           @map("released_to_patient_at")
  uploadedById        String              @map("uploaded_by_id") @db.Uuid
  deletedAt           DateTime?           @map("deleted_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  facility            LabStaffProfile     @relation("MedicalMediaFacility", fields: [facilityId], references: [id])
  patient             Patient             @relation("MedicalMediaPatient", fields: [patientId], references: [id])
  encounter           Encounter?          @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  @@index([facilityId, category])
  @@index([patientId, createdAt(sort: Desc)])
  @@index([patientId, sha256])
  @@map("medical_media")
}

/// A resumable S3 multipart session for one large diagnostic upload. Sessions
/// expire; abandoned ones are aborted by the cleanup job so no orphaned parts
/// or storage charges remain. The staging key keeps the patient scoping used by
/// every other upload path.
model MedicalMediaUploadSession {
  id                String    @id @default(uuid()) @db.Uuid
  facilityId        String    @map("facility_id") @db.Uuid
  patientId         String    @map("patient_id") @db.Uuid
  fileName          String    @map("file_name") @db.VarChar(200)
  mimeType          String    @map("mime_type") @db.VarChar(100)
  formatKey         String    @map("format_key") @db.VarChar(30)
  declaredSizeBytes BigInt    @map("declared_size_bytes")
  declaredSha256    String    @map("declared_sha256") @db.VarChar(64)
  storageKey        String    @unique @map("storage_key")
  s3UploadId        String    @map("s3_upload_id") @db.VarChar(200)
  partSizeBytes     BigInt    @map("part_size_bytes")
  partsTotal        Int       @map("parts_total")
  uploadedById      String    @map("uploaded_by_id") @db.Uuid
  /// ACTIVE while the client may still upload parts; COMPLETED or ABANDONED afterwards.
  status            String    @default("ACTIVE") @db.VarChar(16)
  expiresAt         DateTime  @map("expires_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([facilityId, status])
  @@index([status, expiresAt])
  @@map("medical_media_upload_session")
}

/// A structured nursing observation (vital sign, pain, intake/output...).
/// Timestamped, unit-annotated and attributed; no clinical thresholds are
/// applied automatically — validation is format-only, never interpretive.
model NursingObservation {
  id             String    @id @default(uuid()) @db.Uuid
  facilityId     String    @map("facility_id") @db.Uuid
  patientId      String    @map("patient_id") @db.Uuid
  encounterId    String?   @map("encounter_id") @db.Uuid
  admissionId    String?   @map("admission_id") @db.Uuid
  observationType String    @map("observation_type") @db.VarChar(40)
  value          String    @db.VarChar(60)
  unit           String    @db.VarChar(20)
  recordedAt     DateTime  @map("recorded_at")
  notes          String?   @db.VarChar(500)
  recordedById   String    @map("recorded_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  facility     LabStaffProfile @relation("NursingObservationFacility", fields: [facilityId], references: [id])
  patient      Patient         @relation("NursingObservationPatient", fields: [patientId], references: [id])

  @@index([facilityId, patientId, recordedAt(sort: Desc)])
  @@index([patientId, observationType])
  @@map("nursing_observation")
}

/// A nursing care task with a guarded status lifecycle.
model NursingTask {
  id            String    @id @default(uuid()) @db.Uuid
  facilityId    String    @map("facility_id") @db.Uuid
  patientId     String    @map("patient_id") @db.Uuid
  encounterId   String?   @map("encounter_id") @db.Uuid
  admissionId   String?   @map("admission_id") @db.Uuid
  title         String    @db.VarChar(200)
  instructions  String?   @db.VarChar(1000)
  dueAt         DateTime? @map("due_at")
  status        String    @default("DUE") @db.VarChar(16)
  assignedToId  String?   @map("assigned_to_id") @db.Uuid
  createdById   String    @map("created_by_id") @db.Uuid
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  facility     LabStaffProfile @relation("NursingTaskFacility", fields: [facilityId], references: [id])
  patient      Patient         @relation("NursingTaskPatient", fields: [patientId], references: [id])

  @@index([facilityId, status])
  @@index([facilityId, patientId, status])
  @@index([assignedToId, status])
  @@map("nursing_task")
}

/// A structured shift handover: outstanding tasks and patient context.
model NursingHandover {
  id            String    @id @default(uuid()) @db.Uuid
  facilityId    String    @map("facility_id") @db.Uuid
  patientId     String    @map("patient_id") @db.Uuid
  encounterId   String?   @map("encounter_id") @db.Uuid
  fromUserId    String    @map("from_user_id") @db.Uuid
  toUserId      String?   @map("to_user_id") @db.Uuid
  summary       String    @db.VarChar(2000)
  openTaskIds   Json      @default("[]") @map("open_task_ids")
  createdAt     DateTime  @default(now()) @map("created_at")

  facility     LabStaffProfile @relation("NursingHandoverFacility", fields: [facilityId], references: [id])
  patient      Patient         @relation("NursingHandoverPatient", fields: [patientId], references: [id])

  @@index([facilityId, patientId, createdAt(sort: Desc)])
  @@map("nursing_handover")
}

/// A medication order with a pharmacy workflow (draft → submitted → reviewed
/// → dispensed, with cancel/complete). Orders snapshot the prescriber and keep
/// an auditable status history; dispensing requires REVIEW_MEDICATIONS.
model MedicationOrder {
  id              String    @id @default(uuid()) @db.Uuid
  facilityId      String    @map("facility_id") @db.Uuid
  patientId       String    @map("patient_id") @db.Uuid
  encounterId     String?   @map("encounter_id") @db.Uuid
  medicationName  String    @map("medication_name") @db.VarChar(160)
  strength        String?   @db.VarChar(60)
  dose            String?   @db.VarChar(100)
  route           String?   @db.VarChar(40)
  frequency       String?   @db.VarChar(60)
  duration        String?   @db.VarChar(60)
  notes           String?   @db.VarChar(500)
  prescriberId    String    @map("prescriber_id") @db.Uuid
  status          String    @default("DRAFT") @db.VarChar(16)
  reviewedById    String?   @map("reviewed_by_id") @db.Uuid
  dispensedAt     DateTime? @map("dispensed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  facility       LabStaffProfile @relation("MedicationOrderFacility", fields: [facilityId], references: [id])
  patient        Patient         @relation("MedicationOrderPatient", fields: [patientId], references: [id])
  administrations MedicationAdministration[] @relation("MedicationAdministrationOrder")
  ePrescriptions  EPrescriptionOutbox[]      @relation("EPrescriptionOutboxOrder")

  @@index([facilityId, status])
  @@index([facilityId, patientId, createdAt(sort: Desc)])
  @@map("medication_order")
}

/// MAR entry: one recorded administration (or documented non-administration)
/// against a medication order. Each entry is attributed, timestamped and
/// append-only; it never changes the order itself.
model MedicationAdministration {
  id               String    @id @default(uuid()) @db.Uuid
  facilityId       String    @map("facility_id") @db.Uuid
  patientId        String    @map("patient_id") @db.Uuid
  orderId          String    @map("order_id") @db.Uuid
  encounterId      String?   @map("encounter_id") @db.Uuid
  status           String    @db.VarChar(16)
  administeredDose String?   @map("administered_dose") @db.VarChar(100)
  route            String?   @db.VarChar(40)
  notes            String?   @db.VarChar(500)
  administeredById String    @map("administered_by_id") @db.Uuid
  administeredAt   DateTime  @map("administered_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  facility       LabStaffProfile @relation("MedicationAdministrationFacility", fields: [facilityId], references: [id])
  patient        Patient         @relation("MedicationAdministrationPatient", fields: [patientId], references: [id])
  order          MedicationOrder @relation("MedicationAdministrationOrder", fields: [orderId], references: [id])

  @@index([facilityId, patientId, administeredAt(sort: Desc)])
  @@index([orderId, administeredAt])
  @@map("medication_administration")
}

/// Facility formulary: the medications this hospital stocks, with an optional
/// high-alert marker. Entries are configured by the hospital's own staff; the
/// application makes no clinical claim about any entry.
model FormularyItem {
  id              String   @id @default(uuid()) @db.Uuid
  facilityId      String   @map("facility_id") @db.Uuid
  medicationName  String   @map("medication_name") @db.VarChar(160)
  strength        String?  @db.VarChar(60)
  form            String?  @db.VarChar(60)
  defaultRoute    String?  @map("default_route") @db.VarChar(40)
  highAlert       Boolean  @default(false) @map("high_alert")
  /// Controlled medicine requiring register entries on receipt and dispensing.
  controlled      Boolean  @default(false)
  active          Boolean  @default(true)
  notes           String?  @db.VarChar(500)
  createdById     String   @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  facility       LabStaffProfile @relation("FormularyItemFacility", fields: [facilityId], references: [id])

  @@unique([facilityId, medicationName, strength])
  @@index([facilityId, active])
  @@map("formulary_item")
}

/// A facility-configured interaction rule between two medications. Rules are
/// data entered by the hospital's own clinical staff — the matching engine
/// only reports configured pairs and severity; it never invents rules or
/// recommends dosing.
model MedicationInteractionRule {
  id           String   @id @default(uuid()) @db.Uuid
  facilityId   String   @map("facility_id") @db.Uuid
  medicationA  String   @map("medication_a") @db.VarChar(160)
  medicationB  String   @map("medication_b") @db.VarChar(160)
  severity     String   @db.VarChar(16)
  description  String   @db.VarChar(500)
  active       Boolean  @default(true)
  createdById  String   @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  facility     LabStaffProfile @relation("MedicationInteractionRuleFacility", fields: [facilityId], references: [id])

  @@index([facilityId, medicationA])
  @@index([facilityId, medicationB])
  @@map("medication_interaction_rule")
}

/// Outbound e-prescribing integration boundary. Submitting an order enqueues a
/// snapshot here; delivery requires an explicitly configured external endpoint
/// (EPRESCRIBING_ENDPOINT). Without it, entries remain PENDING and the
/// dependency is documented — no live transmission is claimed.
model EPrescriptionOutbox {
  id         String    @id @default(uuid()) @db.Uuid
  facilityId String    @map("facility_id") @db.Uuid
  orderId    String    @map("order_id") @db.Uuid
  status     String    @default("PENDING") @db.VarChar(16)
  attempts   Int       @default(0)
  lastError  String?   @map("last_error") @db.VarChar(500)
  sentAt     DateTime? @map("sent_at")
  payload    Json
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  facility   LabStaffProfile @relation("EPrescriptionOutboxFacility", fields: [facilityId], references: [id])
  order      MedicationOrder @relation("EPrescriptionOutboxOrder", fields: [orderId], references: [id])

  @@index([facilityId, status])
  @@map("e_prescription_outbox")
}

/// A snapshot of a consultation report taken just before it was amended.
/// Revision N holds the content that was current as revision N.
model ConsultationRevision {
  id             String       @id @default(uuid()) @db.Uuid
  consultationId String       @map("consultation_id") @db.Uuid
  revision       Int
  snapshot       Json
  reason         String?      @db.VarChar(500)
  editedById     String       @map("edited_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@unique([consultationId, revision])
  @@index([consultationId])
  @@map("consultation_revisions")
}

/// A patient's grant letting a whole facility (not one staff user) see a
/// document. Staff access is still limited by their facility permissions.
model DocumentFacilityShare {
  id          String          @id @default(uuid()) @db.Uuid
  documentId  String          @map("document_id") @db.Uuid
  facilityId  String          @map("facility_id") @db.Uuid
  grantedById String          @map("granted_by_id") @db.Uuid
  grantedAt   DateTime        @default(now()) @map("granted_at")
  revokedAt   DateTime?       @map("revoked_at")
  document    PatientDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  facility    LabStaffProfile @relation("FacilityDocumentShares", fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([documentId, facilityId])
  @@index([facilityId, revokedAt])
  @@map("document_facility_shares")
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// A news article published on the platform (managed by admins).
model NewsArticle {
  id            String        @id @default(uuid()) @db.Uuid
  slug          String        @unique @db.VarChar(160)
  title         String        @db.VarChar(200)
  summary       String?       @db.VarChar(500)
  body          String
  coverImageUrl String?       @map("cover_image_url") @db.VarChar(500)
  authorName    String?       @map("author_name") @db.VarChar(120)
  status        PublishStatus @default(DRAFT)
  publishedAt   DateTime?     @map("published_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([status, publishedAt(sort: Desc)])
  @@map("news_articles")
}

/// A podcast episode published on the platform (managed by admins).
model PodcastEpisode {
  id              String        @id @default(uuid()) @db.Uuid
  slug            String        @unique @db.VarChar(160)
  title           String        @db.VarChar(200)
  description     String
  audioUrl        String?       @map("audio_url") @db.VarChar(500)
  coverImageUrl   String?       @map("cover_image_url") @db.VarChar(500)
  durationSeconds Int?          @map("duration_seconds")
  episodeNumber   Int?          @map("episode_number")
  status          PublishStatus @default(DRAFT)
  publishedAt     DateTime?     @map("published_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([status, publishedAt(sort: Desc)])
  @@map("podcast_episodes")
}

enum ProfileReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

enum ProfileReportTarget {
  DOCTOR
  FACILITY
}

/// A signed-in user's report of a doctor or facility profile for admin review.
model ProfileReport {
  id          String              @id @default(uuid()) @db.Uuid
  reporterId  String              @map("reporter_id") @db.Uuid
  targetType  ProfileReportTarget @map("target_type")
  targetId    String              @map("target_id") @db.Uuid
  reason      String              @db.VarChar(40)
  details     String?             @db.VarChar(1000)
  status      ProfileReportStatus @default(OPEN)
  createdAt   DateTime            @default(now()) @map("created_at")
  reviewedAt  DateTime?           @map("reviewed_at")
  reviewedById String?            @map("reviewed_by_id") @db.Uuid

  @@index([status, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([reporterId, targetType, targetId, status])
  @@map("profile_reports")
}

// ============================================================
// Pharmacy inventory, suppliers and controlled-substance register
// ============================================================

model PharmacySupplier {
  id           String   @id @default(uuid()) @db.Uuid
  facilityId   String   @map("facility_id") @db.Uuid
  name         String
  contactName  String?  @map("contact_name")
  email        String?
  phone        String?
  address      String?
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  facility     LabStaffProfile @relation("PharmacySupplierFacility", fields: [facilityId], references: [id], onDelete: Cascade)
  orders       PharmacyPurchaseOrder[] @relation("SupplierOrders")
  batches      PharmacyStockBatch[] @relation("SupplierBatches")

  @@unique([facilityId, name])
  @@map("pharmacy_suppliers")
}

model PharmacyPurchaseOrder {
  id           String   @id @default(uuid()) @db.Uuid
  facilityId   String   @map("facility_id") @db.Uuid
  supplierId   String?  @map("supplier_id") @db.Uuid
  /// DRAFT | SUBMITTED | RECEIVED | CANCELLED
  status       String   @default("DRAFT")
  reference    String?  @db.VarChar(60)
  notes        String?
  createdById  String   @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  facility     LabStaffProfile @relation("PharmacyPurchaseOrderFacility", fields: [facilityId], references: [id], onDelete: Cascade)
  supplier     PharmacySupplier? @relation("SupplierOrders", fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy    User     @relation("PharmacyOrderCreatedBy", fields: [createdById], references: [id])
  items        PharmacyPurchaseOrderItem[]

  @@index([facilityId, status])
  @@map("pharmacy_purchase_orders")
}

model PharmacyPurchaseOrderItem {
  id               String  @id @default(uuid()) @db.Uuid
  orderId          String  @map("order_id") @db.Uuid
  medicationName   String  @map("medication_name") @db.VarChar(160)
  strength         String? @db.VarChar(60)
  form             String? @db.VarChar(60)
  quantity         Int
  unitCost         Decimal? @map("unit_cost") @db.Decimal(10, 2)
  receivedQuantity Int      @default(0) @map("received_quantity")
  createdAt        DateTime @default(now()) @map("created_at")

  order            PharmacyPurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("pharmacy_purchase_order_items")
}

/// A physical batch (lot) of a medication in stock. Dispensing decrements
/// batches first-expiry-first-out; expiry queries drive alerts.
model PharmacyStockBatch {
  id             String    @id @default(uuid()) @db.Uuid
  facilityId     String   @map("facility_id") @db.Uuid
  medicationName String    @map("medication_name") @db.VarChar(160)
  strength       String?  @db.VarChar(60)
  form           String?  @db.VarChar(60)
  batchNumber    String    @map("batch_number") @db.VarChar(80)
  quantity       Int
  unitCost       Decimal? @map("unit_cost") @db.Decimal(10, 2)
  expiresAt      DateTime  @map("expires_at")
  supplierId     String?   @map("supplier_id") @db.Uuid
  receivedAt     DateTime  @default(now()) @map("received_at")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  facility       LabStaffProfile @relation("PharmacyStockBatchFacility", fields: [facilityId], references: [id], onDelete: Cascade)
  supplier       PharmacySupplier? @relation("SupplierBatches", fields: [supplierId], references: [id], onDelete: SetNull)

  @@unique([facilityId, medicationName, batchNumber])
  @@index([facilityId, expiresAt])
  @@map("pharmacy_stock_batches")
}

enum ControlledRegisterEventType {
  RECEIVED
  DISPENSED
  DESTROYED
  RETURNED
  ADJUSTMENT
}

/// Legally required register entry for controlled medicines. Every receipt,
/// dispense, destruction, return and adjustment is recorded with the acting
/// staff member and, where applicable, the patient.
model ControlledSubstanceEvent {
  id             String                      @id @default(uuid()) @db.Uuid
  facilityId    String                      @map("facility_id") @db.Uuid
  medicationName String                      @map("medication_name") @db.VarChar(160)
  eventType      ControlledRegisterEventType
  quantity       Int
  unit           String?                    @db.VarChar(30)
  patientId      String?                     @map("patient_id") @db.Uuid
  staffId        String                      @map("staff_id") @db.Uuid
  reference      String?                     @db.VarChar(160)
  notes          String?
  createdAt      DateTime                    @default(now()) @map("created_at")

  facility       LabStaffProfile             @relation("ControlledEventFacility", fields: [facilityId], references: [id], onDelete: Cascade)
  patient        Patient?                    @relation("ControlledEventPatient", fields: [patientId], references: [id], onDelete: SetNull)
  staff          User                        @relation("ControlledEventCreatedBy", fields: [staffId], references: [id])

  @@index([facilityId, medicationName, createdAt])
  @@map("controlled_substance_events")
}

// ============================================================
// Laboratory equipment, reagents and quality control
// ============================================================

enum LabEquipmentStatus {
  OPERATIONAL
  MAINTENANCE
  OUT_OF_SERVICE
}

model LabEquipment {
  id               String           @id @default(uuid()) @db.Uuid
  facilityId       String           @map("facility_id") @db.Uuid
  name             String
  kind             String?          @db.VarChar(80)
  model            String?          @db.VarChar(120)
  serialNumber     String?          @map("serial_number")
  location         String?          @db.VarChar(120)
  status           LabEquipmentStatus @default(OPERATIONAL)
  lastServicedAt   DateTime?        @map("last_serviced_at")
  nextServiceDueAt DateTime?        @map("next_service_due_at")
  notes            String?
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  facility         LabStaffProfile  @relation("LabEquipmentFacility", fields: [facilityId], references: [id], onDelete: Cascade)
  maintenanceLogs  LabEquipmentMaintenanceLog[]
  qcRuns          LabQualityControlRun[]

  @@index([facilityId, status])
  @@map("lab_equipment")
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  CALIBRATION
}

model LabEquipmentMaintenanceLog {
  id            String        @id @default(uuid()) @db.Uuid
  equipmentId   String        @map("equipment_id") @db.Uuid
  type          MaintenanceType
  performedAt   DateTime      @map("performed_at")
  performedById  String       @map("performed_by_id") @db.Uuid
  downtimeHours Decimal?      @map("downtime_hours") @db.Decimal(6, 1)
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")

  equipment     LabEquipment   @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  performedBy   User           @relation("MaintenancePerformedBy", fields: [performedById], references: [id])

  @@index([equipmentId, performedAt])
  @@map("lab_equipment_maintenance")
}

model LabReagent {
  id                String   @id @default(uuid()) @db.Uuid
  facilityId        String   @map("facility_id") @db.Uuid
  name              String
  manufacturer      String?  @db.VarChar(120)
  lotNumber         String?  @map("lot_number") @db.VarChar(80)
  quantity          Int
  unit              String   @db.VarChar(30)
  minStockLevel     Int      @default(0) @map("min_stock_level")
  expiresAt         DateTime? @map("expires_at")
  storageCondition  String?  @map("storage_condition") @db.VarChar(120)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  facility          LabStaffProfile @relation("LabReagentFacility", fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, expiresAt])
  @@map("lab_reagents")
}

enum QualityControlResult {
  PASS
  FAIL
  WARNING
}

model LabQualityControlRun {
  id           String               @id @default(uuid()) @db.Uuid
  facilityId   String               @map("facility_id") @db.Uuid
  equipmentId  String?              @map("equipment_id") @db.Uuid
  testName     String?              @map("test_name") @db.VarChar(160)
  controlName  String              @map("control_name")
  expected     String?
  observed     String
  result       QualityControlResult
  performedAt  DateTime             @map("performed_at")
  performedById String              @map("performed_by_id") @db.Uuid
  notes        String?
  createdAt    DateTime             @default(now()) @map("created_at")

  facility     LabStaffProfile      @relation("LabQcRunFacility", fields: [facilityId], references: [id], onDelete: Cascade)
  equipment    LabEquipment?        @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  performedBy  User                 @relation("QcPerformedBy", fields: [performedById], references: [id])

  @@index([facilityId, performedAt])
  @@map("lab_quality_control_runs")
}

// ============================================================
// Structured nursing assessments and care plans
// ============================================================

enum NursingAssessmentType {
  FALL_RISK
  PRESSURE_INJURY
  WOUND_CARE
  INTAKE_OUTPUT
  GENERIC
}

/// Structured nursing assessment (fall risk, pressure injury, wound care,
/// intake/output). `data` holds the validated questionnaire answers and
/// `score` the computed risk score where the instrument provides one.
model NursingAssessment {
  id           String               @id @default(uuid()) @db.Uuid
  facilityId   String               @map("facility_id") @db.Uuid
  patientId    String               @map("patient_id") @db.Uuid
  admissionId  String?              @map("admission_id") @db.Uuid
  type         NursingAssessmentType
  data         Json
  score        Int?
  notes        String?
  assessedById String               @map("assessed_by_id") @db.Uuid
  assessedAt   DateTime             @default(now()) @map("assessed_at")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  patient      Patient               @relation("NursingAssessmentPatient", fields: [patientId], references: [id], onDelete: Cascade)
  assessedBy   User                  @relation("NursingAssessmentAssessor", fields: [assessedById], references: [id])

  @@index([facilityId, patientId, assessedAt])
  @@map("nursing_assessments")
}

/// Nursing care plan with goals and interventions. Status lifecycle:
/// ACTIVE | COMPLETED | CANCELLED.
model NursingCarePlan {
  id            String   @id @default(uuid()) @db.Uuid
  facilityId    String   @map("facility_id") @db.Uuid
  patientId     String   @map("patient_id") @db.Uuid
  admissionId   String?  @map("admission_id") @db.Uuid
  goals         String
  interventions Json
  status        String   @default("ACTIVE")
  createdById   String   @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  patient       Patient  @relation("NursingCarePlanPatient", fields: [patientId], references: [id], onDelete: Cascade)
  createdBy     User     @relation("NursingCarePlanAuthor", fields: [createdById], references: [id])

  @@index([facilityId, patientId, status])
  @@map("nursing_care_plans")
}

// ============================================================
// AI governance: usage audit log
// ============================================================

/// Every AI feature call is logged with the acting user, facility and
/// patient references (ids only — clinical content stays out of logs),
/// the provider/model used and the outcome. Reviewable by compliance.
model AiUsageLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  facilityId  String?  @map("facility_id") @db.Uuid
  patientId   String?  @map("patient_id") @db.Uuid
  /// DOCTOR_ASSISTANT | NURSING_HANDOVER | PHARMACY_REVIEW | ADMIN_SUMMARY |
  /// PATIENT_ASSISTANT | LAB_INTERPRETATION ...
  feature     String   @db.VarChar(60)
  provider    String   @db.VarChar(40)
  model       String?
  /// COMPLETED | ERROR | REJECTED
  status      String   @db.VarChar(20)
  /// References to the inputs used (encounter id, order id, ...). No PHI values.
  inputRefs   Json     @default("[]")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation("AiUsageLogUser", fields: [userId], references: [id])
  facility    LabStaffProfile? @relation("AiUsageLogFacility", fields: [facilityId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([facilityId, createdAt])
  @@map("ai_usage_logs")
}

// ---------------------------------------------------------------------------
// Super Admin Control Centre — platform administrative organization.
// Administrative authority is deliberately separate from clinical privileges:
// no membership, role or override below ever grants access to patient records,
// prescriptions, results or clinical documents. Clinical access stays in the
// facility staff / StaffPatientAccess / ClinicalPrivilege models.
// ---------------------------------------------------------------------------

/// Platform administrative departments (internal operating structure).
model AdminDepartment {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  description String            @default("")
  parentId    String?           @map("parent_id") @db.Uuid
  parent      AdminDepartment?  @relation("AdminDeptTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    AdminDepartment[] @relation("AdminDeptTree")
  rank        Int               @default(0)
  active      Boolean           @default(true)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  teams       AdminTeam[]
  memberships AdminMembership[]
  roles       AdminRole[]

  @@map("admin_departments")
}

/// Administrative teams and subteams inside a department.
model AdminTeam {
  id                  String           @id @default(uuid()) @db.Uuid
  departmentId        String?          @map("department_id") @db.Uuid
  department          AdminDepartment?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  name                String
  description         String           @default("")
  leaderMembershipId  String?          @map("leader_membership_id") @db.Uuid
  leaderMembership    AdminMembership?  @relation("AdminTeamLeader", fields: [leaderMembershipId], references: [id], onDelete: SetNull)
  active              Boolean          @default(true)
  createdAt           DateTime         @default(now()) @map("created_at")
  memberships         AdminMembership[] @relation("AdminTeamMembers")

  @@map("admin_teams")
}

/// An internal administrator's position: title, responsibilities, reporting
/// line, team/department and a bounded access window. Expiry and suspension
/// are enforced on every request — never only in the UI.
model AdminMembership {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  user            User              @relation("AdminMembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  departmentId    String?           @map("department_id") @db.Uuid
  department      AdminDepartment?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teamId          String?           @map("team_id") @db.Uuid
  team            AdminTeam?         @relation("AdminTeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  reportsToId     String?           @map("reports_to_id") @db.Uuid
  reportsTo       AdminMembership?   @relation("AdminReporting", fields: [reportsToId], references: [id], onDelete: SetNull)
  directReports   AdminMembership[]  @relation("AdminReporting")
  ledTeams        AdminTeam[]        @relation("AdminTeamLeader")
  title           String
  responsibilities String            @default("")
  /// ACTIVE | SUSPENDED | ENDED
  status          String            @default("ACTIVE")
  startsAt        DateTime          @default(now()) @map("starts_at")
  endsAt          DateTime?         @map("ends_at")
  createdById     String            @map("created_by_id") @db.Uuid
  createdBy       User              @relation("AdminMembershipCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  roleAssignments AdminRoleAssignment[]

  @@index([userId])
  @@index([status, endsAt])
  @@map("admin_memberships")
}

/// Predefined and custom administrative roles. Roles never carry clinical
/// permissions — those live in ClinicalPrivilege and are granted per facility.
model AdminRole {
  id           String                @id @default(uuid()) @db.Uuid
  key          String                @unique
  name         String
  description  String                @default("")
  departmentId String?               @map("department_id") @db.Uuid
  department   AdminDepartment?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  /// System roles ship with the platform and cannot be deleted.
  system       Boolean               @default(false)
  active       Boolean               @default(true)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  permissions  AdminRolePermission[]
  assignments  AdminRoleAssignment[]

  @@map("admin_roles")
}

/// A single permission key ("SECTION:VERB") granted to a role.
model AdminRolePermission {
  id            String    @id @default(uuid()) @db.Uuid
  roleId        String    @map("role_id") @db.Uuid
  role          AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionKey String    @map("permission_key")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([roleId, permissionKey])
  @@map("admin_role_permissions")
}

/// Role-to-user assignment with its own reason and optional expiry.
model AdminRoleAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation("AdminRoleAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  roleId       String    @map("role_id") @db.Uuid
  role         AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  membershipId String?   @map("membership_id") @db.Uuid
  membership   AdminMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  assignedById String    @map("assigned_by_id") @db.Uuid
  assignedBy   User      @relation("AdminRoleAssignmentCreator", fields: [assignedById], references: [id], onDelete: Restrict)
  reason       String
  expiresAt    DateTime? @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("admin_role_assignments")
}

/// Approved exceptions: an explicit GRANT or DENY of one permission key for
/// one user, with reason, approver and optional expiry. DENY always wins.
model AdminPermissionOverride {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  user          User      @relation("AdminOverrideUser", fields: [userId], references: [id], onDelete: Cascade)
  permissionKey String    @map("permission_key")
  /// GRANT | DENY
  effect        String
  reason        String
  expiresAt     DateTime? @map("expires_at")
  createdById   String    @map("created_by_id") @db.Uuid
  createdBy     User      @relation("AdminOverrideCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([userId, permissionKey])
  @@map("admin_permission_overrides")
}

/// Configurable approval gate for sensitive actions. The requester can never
/// be an approver, and a dual-approval workflow needs two distinct approvers.
model ApprovalWorkflow {
  id                    String             @id @default(uuid()) @db.Uuid
  actionKey             String             @unique @map("action_key")
  name                  String
  description           String             @default("")
  approverRoleKey       String             @map("approver_role_key")
  secondApproverRoleKey String?            @map("second_approver_role_key")
  requiresReauth        Boolean            @default(true) @map("requires_reauth")
  active                Boolean            @default(true)
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  requests              ApprovalRequest[]

  @@map("approval_workflows")
}

model ApprovalRequest {
  id          String             @id @default(uuid()) @db.Uuid
  workflowId  String             @map("workflow_id") @db.Uuid
  workflow    ApprovalWorkflow    @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  actionKey   String             @map("action_key")
  requesterId String             @map("requester_id") @db.Uuid
  requester   User               @relation("ApprovalRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  payload     Json
  reason      String
  /// PENDING | APPROVED | REJECTED | CANCELLED
  status      String             @default("PENDING")
  decisions   ApprovalDecision[]
  createdAt   DateTime           @default(now()) @map("created_at")
  decidedAt   DateTime?          @map("decided_at")

  @@index([status, createdAt])
  @@map("approval_requests")
}

/// One approver's signature on a request. Unique per request+approver.
model ApprovalDecision {
  id             String           @id @default(uuid()) @db.Uuid
  requestId      String           @map("request_id") @db.Uuid
  request        ApprovalRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  deciderId      String           @map("decider_id") @db.Uuid
  decider        User             @relation("ApprovalDecider", fields: [deciderId], references: [id], onDelete: Restrict)
  /// APPROVE | REJECT
  decision       String
  reason         String
  createdAt      DateTime         @default(now()) @map("created_at")

  @@unique([requestId, deciderId])
  @@map("approval_decisions")
}

/// Security and privacy incidents tracked in the Security Centre.
model SecurityIncident {
  id            String    @id @default(uuid()) @db.Uuid
  /// SUSPICIOUS_LOGIN | PRIVILEGE_MISUSE | DATA_EXPORT | BREACH_INVESTIGATION | POLICY_VIOLATION | OTHER
  kind          String
  /// LOW | MEDIUM | HIGH | CRITICAL
  severity      String
  title         String
  description   String
  /// OPEN | INVESTIGATING | CONTAINED | RESOLVED
  status        String    @default("OPEN")
  reportedById  String    @map("reported_by_id") @db.Uuid
  reportedBy    User      @relation("IncidentReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  assignedToId  String?   @map("assigned_to_id") @db.Uuid
  assignedTo    User?     @relation("IncidentAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolution    String?
  resolvedAt    DateTime? @map("resolved_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("security_incidents")
}

/// Standard medical departments and specialties offered platform-wide.
model GlobalSpecialty {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  /// CLINICAL | LABORATORY | DIAGNOSTIC | NURSING | PHARMACY | ADMINISTRATIVE
  category    String
  description String   @default("")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("global_specialties")
}

/// Global platform settings (branding, defaults, retention, limits). Every
/// change is recorded in the tamper-evident control audit trail.
model PlatformSetting {
  key         String   @id
  value       Json
  description String   @default("")
  updatedById String   @map("updated_by_id") @db.Uuid
  updatedBy   User     @relation("PlatformSettingEditor", fields: [updatedById], references: [id], onDelete: Restrict)
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("platform_settings")
}
