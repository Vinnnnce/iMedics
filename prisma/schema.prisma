model CareCase {
  id                  String             @id @default(uuid()) @db.Uuid
  /// MED1905-<TYPE>-<YEAR>-<SEQUENCE>, generated server-side only.
  caseNumber          String             @unique @map("case_number")
  type                CareCaseType
  status              CareCaseStatus     @default(OPEN)
  patientId           String             @map("patient_id") @db.Uuid
  /// The doctor primarily responsible for the episode, when one exists.
  primaryDoctorId     String?            @map("primary_doctor_id") @db.Uuid
