# ---------- Database (Neon) ----------
# Pooled connection string for the app, direct one for migrations.
DATABASE_URL=
DIRECT_URL=

# ---------- Authentication (Clerk) ----------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated emails that become admin on first sign-in (verify the email in Clerk).
ADMIN_EMAILS=

# ---------- Public URL ----------
# Used for links in emails and payment redirects. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- File storage (AWS S3) ----------
# Leave S3_ENDPOINT empty to use the AWS endpoint for S3_REGION.
S3_ENDPOINT=
# Set this to the AWS region containing the bucket.
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- AI assistance (optional) ----------
KIMI_API_KEY=
KIMI_API_URL=
KIMI_MODEL=
AI_RATE_LIMIT_PER_HOUR=

# ---------- Payments (Paystack) ----------
# Leave PAYSTACK_SECRET_KEY empty in development to use the built-in test checkout (no money moves).
# The mock provider is refused when NODE_ENV=production.
PAYSTACK_SECRET_KEY=
# Optional override: "paystack" or "mock".
PAYMENT_PROVIDER=
# In the Paystack dashboard, set the webhook URL to: <NEXT_PUBLIC_APP_URL>/api/payments/webhook/paystack

# ---------- Email notifications (Resend) ----------
# Without a key, emails are logged to the server console instead of being sent.
RESEND_API_KEY=
# A sender on a domain you have verified with Resend, e.g. "Medic1905 <notifications@yourdomain.com>"
EMAIL_FROM=

# ---------- Push notifications (Web Push) ----------
# Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com

# ---------- Scheduled jobs ----------
# Secret for GET /api/cron/appointment-reminders (send as "Authorization: Bearer <secret>").
# Vercel Cron adds this header automatically when CRON_SECRET is set.
CRON_SECRET=

# ---------- Diagnostic media (optional) ----------
# Malware scanning hook for HIS uploads: POST {bucket,key} -> {result:"CLEAN"|"INFECTED"}.
# Without it uploads are recorded as NOT_SCANNED (file-signature checks only).
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=

# ---------- Tests ----------
# Optional: a disposable, fully migrated database for the end-to-end money-flow tests (npm test).
TEST_DATABASE_URL=
