# Medic1905 — copy to .env and fill in real values. Never commit .env.

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Neon Postgres
# Pooled connection string (used at runtime)
DATABASE_URL=''
#Direct (non-pooled) connection string (used by `prisma migrate`)
DIRECT_URL=""
# Kimi K3 (AI assistance for doctors)
KIMI_API_KEY="your-kimi-api-key"
KIMI_API_URL=""
KIMI_MODEL="kimi-k3"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Comma-separated emails that become ADMIN on first sign-in (only if Clerk marks the email verified)
ADMIN_EMAILS=""

# File storage (any S3-compatible bucket: AWS S3, Cloudflare R2, ...). The bucket must be private.
S3_BUCKET=""
S3_REGION=
AWS_REGION=1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---------- Payments (Paystack) ----------
# Leave PAYSTACK_SECRET_KEY empty in development to use the built-in test checkout (no money moves).
# The mock provider is refused when NODE_ENV=production.
PAYSTACK_SECRET_KEY=
# Optional override: "paystack" or "mock".
PAYMENT_PROVIDER=
# In the Paystack dashboard, set the webhook URL to: <NEXT_PUBLIC_APP_URL>/api/payments/webhook/paystack

# ---------- Email notifications (Resend) ----------
# Without a key, emails are logged to the server console instead of being sent.
RESEND_API_KEY=""
# A sender on a domain you have verified with Resend, e.g. "Medic1905 <notifications@yourdomain.com>"
EMAIL_FROM=">"

# ---------- Push notifications (Web Push) ----------
# Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:"

# ---------- Scheduled jobs ----------
# Secret for GET /api/cron/appointment-reminders (send as "Authorization: Bearer <secret>").
# Vercel Cron adds this header automatically when CRON_SECRET is set.
CRON_SECRET=

# ---------- Tests ----------
# Optional: a disposable, fully migrated database for the end-to-end money-flow tests (npm test).
TEST_DATABASE_URL=
